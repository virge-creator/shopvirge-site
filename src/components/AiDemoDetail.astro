---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import Term from './Term.astro';
import { concerns } from '../data/mkb-concerns';

interface Props { lang: 'en' | 'nl'; demo: 'photo' | 'lego' }
const { lang, demo } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL;
const videoBase = `${base}videos/ai-demos/`;
const imageBase = `${base}images/ai-demos/`;
const overview = `${base}${lang}/ai-demos/`;
const contact = `${base}${lang}/contact/?type=demo`;
// Concern copy is written against the LEGO recording, so only that page uses it.
const concernCopy = demo === 'lego' ? concerns : [];
const note = (id: number) => concernCopy.find((c) => c.id === id && c.tier === 'inline')?.[lang].note;
const concernFaq = concernCopy.filter((c) => c.tier === 'faq').map((c) => ({ q: c[lang].concern!, a: c[lang].answer! }));
const other = demo === 'photo' ? 'lego' : 'photo';
const copy = {
  en: {
    photo: {
      title: 'Create a webshop product from a photo',
      description: 'Watch a connected AI assistant identify a second-hand computer power supply from a photo and create a product in a ShopVirge demo shop.',
      intro: 'See how a single product photo becomes a listing in a ShopVirge demo shop.',
      other: 'Watch the LEGO set number demo',
      video: 'shop',
    },
    lego: {
      title: 'Add LEGO sets from their set numbers',
      description: 'Watch a connected AI assistant look up five LEGO set numbers and create product listings in a ShopVirge demo shop.',
      intro: 'See how five LEGO set numbers become products in a ShopVirge demo shop.',
      other: 'Watch the product photo demo',
      video: 'lego',
    },
  },
  nl: {
    photo: {
      title: 'Van productfoto naar product in je webshop',
      description: 'Bekijk hoe een gekoppelde AI-assistent een tweedehands computervoeding herkent op een foto en een product aanmaakt in een ShopVirge-demoshop.',
      intro: 'Bekijk hoe een productfoto een vermelding wordt in een ShopVirge-demoshop.',
      other: 'Bekijk de LEGO-setnummerdemo',
      video: 'shop',
    },
    lego: {
      title: 'LEGO-sets toevoegen met setnummers',
      description: 'Bekijk hoe een gekoppelde AI-assistent vijf LEGO-setnummers opzoekt en producten aanmaakt in een ShopVirge-demoshop.',
      intro: 'Bekijk hoe vijf LEGO-setnummers producten worden in een ShopVirge-demoshop.',
      other: 'Bekijk de productfotodemo',
      video: 'lego',
    },
  },
}[lang][demo];
const ui = en ? {
  eyebrow: 'ShopVirge AI demo',
  recordingWord: 'Screen recording', shopWord: 'demo shop',
  fallback: 'Your browser does not support video playback.',
  cta: 'Request a demo',
} : {
  eyebrow: 'ShopVirge AI-demo',
  recordingWord: 'Schermopname', shopWord: 'demoshop',
  fallback: 'Je browser ondersteunt het afspelen van video niet.',
  cta: 'Vraag een demo aan',
};
const details = {
  en: {
    photo: {
      input: 'A product photo', output: 'One new product',
      prompt: 'Can you add this second hand PSU to my store, you can fill out all the details yourself', inputImage: 'psu-photo', numbers: [],
      cards: ['psu-card'],
      inputLabel: 'One photo',
      beforeCost: 'About 10 minutes per product',
      ctaTitle: 'How many items are waiting for a listing right now?',
          outputs: ['Product title', 'Description', 'Price incl. VAT', 'SKU', 'Category', 'Product photo'],
      before: ['Read the label and identify the exact model', 'Look up the specifications', 'Write a title and description', 'Pick or create a category', 'Decide on a price incl. VAT', 'Upload the photo and fill in the product form'],
      problemTitle: 'You have the item. Writing the listing is the slow part.',
      problemBody: 'With second-hand stock every item is different. Looking up the exact model, writing a description and choosing a category takes far longer than taking the photo: easily 10 minutes per product, every time.',
      faq: [
        { q: 'What if the assistant gets the model wrong?', a: 'You check every product before you sell it. The product is created in ShopVirge, so you can correct the name, specifications or description there.' },
        { q: 'Does my own photo end up on the product page?', a: 'Yes. In the recording the original photo and the drafted description appear together on the storefront page.' },
        { q: 'Is the recording sped up?', a: 'Yes, the recording is sped up so it stays short. The steps and the result in the shop are as recorded.' },
      ],
      ctaBody: 'Bring a few photos of items you sell. We will look at them with you and discuss a setup that fits your shop.',
      caption: 'A second-hand Cooler Master V650 power supply goes from a photo in the chat to a product page in the demo shop.',
      useTitle: 'Useful when every item is different',
      useBody: 'For second-hand or one-off stock, you may have a photo long before you have a polished description. This example shows how an assistant can help turn that starting point into a catalogue entry. You still decide whether the condition, specifications and wording accurately describe the item you are selling.',
      review: ['Does the model and condition match the actual item?', 'Are the description, category and photo right?', 'Is the price appropriate for your stock?'],
      otherTitle: 'Have item numbers instead?',
      otherBody: 'See the second demo, where five LEGO set numbers become five products in the shop.',
    },
    lego: {
      input: 'Five set numbers', output: 'Five new products',
      beforeCost: '~10 min × 5 sets = almost an hour',
      ctaTitle: 'How many sets are waiting to be listed right now?',
          prompt: 'I want to add 5 LEGO kits to my shop: 42231, 42221, 31387, 11385, 11378', inputImage: '', numbers: ['42231', '42221', '31387', '11385', '11378'],
      cards: ['lego-42231', 'lego-42221', 'lego-31387', 'lego-11385', 'lego-11378'],
      before: ['Look up the set name and theme', 'Find a product image', 'Write a title and description', 'Pick a category', 'Decide on a price', 'Fill in the product form'],
      problemTitle: 'You know the set numbers. Typing every listing is the slow part.',
      problemBody: 'A set number tells you exactly what you have. Entering the title, description, images and category by hand still takes around 10 minutes per set. For these five sets, that is almost an hour of typing.',
      faq: [
        { q: 'Does it import my Marktplaats or 2dehands listings?', a: 'Yes, we can set that up for your shop. In this recording the set numbers are typed into the assistant, but importing your existing Marktplaats or 2dehands listings is possible. Ask us about it in a demo.' },
        { q: 'Where do the details and images come from?', a: 'The assistant looks up information for each set number. Check that the images and details match the set you are selling.' },
        { q: 'Is the recording sped up?', a: 'Yes, the recording is sped up so it stays short. The steps and the result in the shop are as recorded.' },
      ],
      ctaBody: 'Bring a list of set or item numbers you sell. We will look at them with you and discuss a setup that fits your shop.',
      caption: 'A short list of set numbers becomes five second-hand LEGO products in the demo storefront.',
      useTitle: 'A practical example for marketplace sellers',
      useBody: 'If you sell LEGO sets on Marktplaats, 2dehands or 2ememain, their set numbers can also help you organise the same stock in your own ShopVirge catalogue. In this recording the numbers are typed into the assistant. Importing your existing marketplace listings is also possible; ask us about it.',
      review: ['Are the set number and product image the right match?', 'Is the set complete, and is its condition described correctly?', 'Do the price and category fit your stock?'],
      otherTitle: 'Only have a photo?',
      otherBody: 'See how the assistant starts with a photo of a second-hand power supply instead.',
    },
  },
  nl: {
    photo: {
      input: 'Een productfoto', output: 'Eén nieuw product',
      prompt: 'Can you add this second hand PSU to my store, you can fill out all the details yourself', inputImage: 'psu-photo', numbers: [],
      cards: ['psu-card'],
      inputLabel: 'Eén foto',
      beforeCost: 'Zo’n 10 minuten per product',
      ctaTitle: 'Hoeveel artikelen wachten nu nog op een producttekst?',
          outputs: ['Producttitel', 'Beschrijving', 'Prijs incl. btw', 'SKU', 'Categorie', 'Productfoto'],
      before: ['Het label lezen en het exacte model bepalen', 'De specificaties opzoeken', 'Een titel en beschrijving schrijven', 'Een categorie kiezen of aanmaken', 'Een prijs incl. btw bepalen', 'De foto uploaden en het productformulier invullen'],
      problemTitle: 'Je hebt het artikel. De producttekst schrijven is het trage deel.',
      problemBody: 'Bij tweedehands voorraad is elk artikel anders. Het exacte model opzoeken, een beschrijving schrijven en een categorie kiezen kost veel meer tijd dan de foto maken: al snel 10 minuten per product, elke keer weer.',
      faq: [
        { q: 'Wat als de assistent het verkeerde model herkent?', a: 'Je controleert elk product voordat je het verkoopt. Het product staat in ShopVirge, dus je past de naam, specificaties of beschrijving daar aan.' },
        { q: 'Komt mijn eigen foto op de productpagina?', a: 'Ja. In de opname staan de oorspronkelijke foto en de opgestelde beschrijving samen op de productpagina.' },
        { q: 'Is de opname versneld?', a: 'Ja, de opname is versneld, zodat hij kort blijft. De stappen en het resultaat in de shop zijn zoals opgenomen.' },
      ],
      ctaBody: 'Neem een paar foto’s mee van artikelen die je verkoopt. We bekijken ze samen en bespreken welke inrichting bij je shop past.',
      caption: 'Een tweedehands Cooler Master V650-voeding gaat van een foto in de chat naar een productpagina in de demoshop.',
      useTitle: 'Handig als elk artikel anders is',
      useBody: 'Bij tweedehands of unieke voorraad heb je soms al een foto, maar nog geen goede producttekst. Dit voorbeeld laat zien hoe een assistent van die foto een catalogusvermelding kan maken. Je bepaalt zelf of de staat, specificaties en tekst kloppen voor het artikel dat je verkoopt.',
      review: ['Kloppen het model en de staat met het echte artikel?', 'Zijn de beschrijving, categorie en foto juist?', 'Past de prijs bij jouw voorraad?'],
      otherTitle: 'Heb je artikelnummers?',
      otherBody: 'Bekijk de tweede demo: vijf LEGO-setnummers worden vijf producten in de shop.',
    },
    lego: {
      input: 'Vijf setnummers', output: 'Vijf nieuwe producten',
      beforeCost: '~10 min × 5 sets = bijna een uur',
      ctaTitle: 'Hoeveel sets wachten nu nog om online te komen?',
          prompt: 'I want to add 5 LEGO kits to my shop: 42231, 42221, 31387, 11385, 11378', inputImage: '', numbers: ['42231', '42221', '31387', '11385', '11378'],
      cards: ['lego-42231', 'lego-42221', 'lego-31387', 'lego-11385', 'lego-11378'],
      before: ['De setnaam en het thema opzoeken', 'Een productafbeelding zoeken', 'Een titel en beschrijving schrijven', 'Een categorie kiezen', 'Een prijs bepalen', 'Het productformulier invullen'],
      problemTitle: 'Je kent de setnummers. Elke vermelding uittypen is het trage deel.',
      problemBody: 'Een setnummer zegt precies wat je hebt. Toch kost het invoeren van titel, beschrijving, afbeeldingen en categorie zo’n 10 minuten per set. Voor deze vijf sets is dat bijna een uur typen.',
      faq: [
        { q: 'Importeert dit mijn advertenties van Marktplaats of 2dehands?', a: 'Ja, dat kunnen we voor je shop inrichten. In deze opname worden de setnummers aan de assistent gegeven, maar je bestaande advertenties van Marktplaats of 2dehands importeren is mogelijk. Vraag ernaar tijdens een demo.' },
        { q: 'Waar komen de gegevens en afbeeldingen vandaan?', a: 'De assistent zoekt informatie op bij elk setnummer. Controleer of de afbeeldingen en gegevens passen bij de set die je verkoopt.' },
        { q: 'Is de opname versneld?', a: 'Ja, de opname is versneld, zodat hij kort blijft. De stappen en het resultaat in de shop zijn zoals opgenomen.' },
      ],
      ctaBody: 'Neem een lijst set- of artikelnummers mee die je verkoopt. We bekijken ze samen en bespreken welke inrichting bij je shop past.',
      caption: 'Een korte lijst setnummers wordt vijf tweedehands LEGO-producten in de demoshop.',
      useTitle: 'Een voorbeeld voor verkopers op marktplaatsen',
      useBody: 'Verkoop je LEGO-sets op Marktplaats, 2dehands of 2ememain? Dan kunnen de setnummers ook helpen om dezelfde voorraad in je eigen ShopVirge-catalogus op te nemen. In deze opname worden de nummers aan de assistent gegeven. Je bestaande advertenties van die platforms importeren kan ook; vraag ernaar.',
      review: ['Passen het setnummer en de productafbeelding bij elkaar?', 'Is de set compleet en is de staat goed beschreven?', 'Kloppen de prijs en categorie voor jouw voorraad?'],
      otherTitle: 'Heb je alleen een foto?',
      otherBody: 'Bekijk hoe de assistent begint met een foto van een tweedehands computervoeding.',
    },
  },
}[lang][demo];
const faqItems = [...details.faq, ...concernFaq];
// Two independent columns (first half, second half) so card heights in one never stretch the other, and the order still reads top to bottom on phones.
const faqSplit = Math.ceil(faqItems.length / 2);
const faqColumns = [faqItems.slice(0, faqSplit), faqItems.slice(faqSplit)];
const labels = en ? {
  discuss: 'Discuss your shop', input: 'You send', output: 'You get',
  before: 'By hand', beforeNote: 'For every product, before it can go online:', after: 'With the assistant', afterNote: 'One message in the chat:', created: 'Created in the demo shop',
  afterCost: 'One message instead',
  problem: 'Sound familiar?', fit: 'You stay in charge',
  review: 'What you would check before selling', faq: 'Questions about this demo',
} : {
  discuss: 'Bespreek jouw shop', input: 'Je stuurt', output: 'Je krijgt',
  before: 'Met de hand', beforeNote: 'Voor elk product, voordat het online kan:', after: 'Met de assistent', afterNote: 'Eén bericht in de chat:', created: 'Aangemaakt in de demoshop',
  afterCost: 'Eén bericht in plaats daarvan',
  problem: 'Herkenbaar?', fit: 'Jij houdt de regie',
  review: 'Wat je controleert voor de verkoop', faq: 'Vragen over deze demo',
};
---
<Layout title={copy.title} description={copy.description} lang={lang} image={`https://shopvirge.com${videoBase}${copy.video}-wide.webp`}>
  <section class="hero text-white py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-12 items-center">
        <div class="lg:col-span-5">
          <span class="inline-flex items-center rounded-full bg-white/20 px-4 py-1.5 text-sm font-semibold mb-8">{ui.eyebrow}</span>
          <h1 class="text-4xl md:text-5xl font-extrabold leading-tight mb-6">{copy.title}</h1>
          <p class="text-lg md:text-xl text-white/85 leading-relaxed">{copy.intro}</p>
          {note(4) && <p class="mt-3 text-sm text-white/70">{note(4)}</p>}
          <div class="mt-8 flex items-center gap-4 sm:gap-6">
            <div class="min-w-0">
              <p class="text-xs font-semibold uppercase tracking-wide text-white/70 mb-2">{labels.input}</p>
              {details.inputImage
                ? <figure><img src={`${imageBase}${details.inputImage}.webp`} alt="" class="h-24 w-24 rounded-xl object-cover ring-4 ring-white/20 shadow-lg" />{details.inputLabel && <figcaption class="mt-2 text-sm font-medium">{details.inputLabel}</figcaption>}</figure>
                : <ul class="grid grid-cols-3 gap-1.5 w-max">{details.numbers.map((n) => <li class="rounded-md bg-white/15 px-2 py-1 font-mono text-sm">{n}</li>)}</ul>}
            </div>
            <span aria-hidden="true" class="mt-6 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-amber-400 text-surface-dark shadow-lg"><Icon name="arrow-right" size={20} /></span>
            <div class="min-w-0">
              <p class="text-xs font-semibold uppercase tracking-wide text-white/70 mb-2">{labels.output}</p>
              {details.outputs
                ? <ul class="grid gap-y-2 sm:grid-cols-2 sm:gap-x-5">{details.outputs.map((item) => <li class="flex items-center gap-2 text-sm font-medium whitespace-nowrap"><span class="text-amber-400"><Icon name="circle-check" size={16} /></span>{item}</li>)}</ul>
                : <div class="flex">
                    {details.cards.map((card, index) => (
                      <img src={`${imageBase}${card}.webp`} alt="" class={`h-28 w-auto rounded-lg shadow-xl ring-2 ring-white/20 ${index > 0 ? '-ml-10 sm:-ml-8' : ''}`} style={`transform: rotate(${(index - (details.cards.length - 1) / 2) * 4}deg)`} />
                    ))}
                  </div>}
            </div>
          </div>
          <a href={contact} class="mt-8 inline-flex items-center justify-center rounded-full border border-white/60 px-6 py-3 font-semibold text-white hover:bg-white/10 transition-colors" data-open-demo>{labels.discuss} →</a>
        </div>
        <figure id="recording" class="lg:col-span-7 rounded-2xl bg-surface-dark p-2 sm:p-3 shadow-2xl scroll-mt-16">
          <video class="hidden sm:block w-full rounded-xl bg-black aspect-video" data-hero-video muted loop playsinline controls preload="metadata" poster={`${videoBase}${copy.video}-wide-result.webp`} aria-label={copy.title}>
            <source src={`${videoBase}${copy.video}-wide.mp4#t=${copy.video === 'lego' ? 13 : 10}`} type="video/mp4" />{ui.fallback}
          </video>
          <video class="sm:hidden w-full rounded-xl bg-black aspect-[9/16] max-h-[65vh] object-contain" muted loop playsinline controls preload="none" poster={`${videoBase}${copy.video}-vertical.webp`} aria-label={copy.title}>
            <source src={`${videoBase}${copy.video}-vertical.mp4`} type="video/mp4" />{ui.fallback}
          </video>
          <figcaption class="px-2 pt-3 pb-1 text-white/70 text-xs font-medium"><Term id="recording" lang={lang}>{ui.recordingWord}</Term> · ShopVirge <Term id="demoShop" lang={lang}>{ui.shopWord}</Term>{note(1) && <span class="block mt-1 font-normal">{note(1)}</span>}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <main>
    <section class="py-16 md:py-24" aria-labelledby="problem-heading">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-12">
          <span class="text-accent font-semibold tracking-wide uppercase text-sm">{labels.problem}</span>
          <h2 id="problem-heading" class="text-3xl md:text-4xl font-bold text-gray-900 mt-3 mb-5">{details.problemTitle}</h2>
          <p class="text-lg text-gray-600 leading-relaxed">{details.problemBody}</p>
        </div>
        <div class="grid gap-6 lg:grid-cols-12">
          <div class="lg:col-span-5 rounded-2xl border border-gray-200 bg-surface p-7 md:p-8">
            <div class="flex items-center justify-between gap-4 mb-2">
              <h3 class="text-xl font-bold text-gray-500">{labels.before}</h3>
            </div>
            <p class="text-sm text-gray-500 mb-2">{labels.beforeNote}</p>
            <p class="mb-6 inline-flex items-center gap-2 rounded-full bg-accent/10 px-3 py-1 text-sm font-semibold text-accent"><Icon name="clock" size={16} />{details.beforeCost}</p>
            <ol class="space-y-3">
              {details.before.map((task, index) => (
                <li class="flex items-center gap-3 rounded-xl bg-white px-4 py-3 text-gray-600 shadow-sm">
                  <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-xs font-bold text-gray-500">{index + 1}</span>{task}
                </li>
              ))}
            </ol>
          </div>
          <div class="lg:col-span-7 rounded-2xl bg-surface-dark p-7 md:p-8 text-white shadow-xl">
            <h3 class="text-xl font-bold mb-2">{labels.after}</h3>
            <p class="text-sm text-white/70 mb-2">{labels.afterNote}</p>
            <p class="mb-5 inline-flex items-center gap-2 rounded-full bg-amber-400/15 px-3 py-1 text-sm font-semibold text-amber-400"><Icon name="zap" size={16} />{labels.afterCost}</p>
            <div class="ml-auto max-w-md rounded-2xl rounded-br-sm bg-white px-4 py-3 text-gray-900 shadow-lg">
              {details.inputImage && <img src={`${imageBase}${details.inputImage}.webp`} alt="" class="mb-3 h-24 w-24 rounded-lg object-cover" />}
              <p class="text-sm leading-relaxed">“{details.prompt}”</p>
            </div>
            <p class="mt-8 mb-4 flex items-center gap-2 text-sm font-semibold text-amber-400"><Icon name="circle-check" size={18} />{labels.created}</p>
            <ul class="flex flex-wrap gap-3">
              {details.cards.map((card) => (
                <li class="w-[calc(33.333%-0.5rem)] sm:w-[calc(20%-0.6rem)] min-w-24 max-w-44"><img src={`${imageBase}${card}.webp`} alt="" loading="lazy" class="w-full aspect-[300/520] object-cover object-top rounded-lg ring-1 ring-white/10" /></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section-alt py-16 md:py-24" aria-labelledby="fit-heading">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <span class="text-brand font-semibold tracking-wide uppercase text-sm">{labels.fit}</span>
          <h2 id="fit-heading" class="text-3xl font-bold text-gray-900 mt-3 mb-5">{details.useTitle}</h2>
          <p class="text-lg text-gray-600 leading-relaxed">{details.useBody}</p>
        </div>
        <div class="rounded-2xl bg-white p-7 md:p-8 shadow-sm">
          <h3 class="text-xl font-bold text-gray-900 mb-2">{labels.review}</h3>
          {note(3) && <p class="mb-5 text-sm text-gray-500">{note(3)}</p>}
          <ul class="space-y-4 text-gray-600">
            {details.review.map((item) => (
              <li class="flex items-start gap-3"><span class="mt-1 text-accent-secondary"><Icon name="check" size={19} /></span>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24" aria-labelledby="faq-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="faq-heading" class="text-3xl md:text-4xl font-bold text-gray-900 mb-10">{labels.faq}</h2>
        <div class="flex flex-col gap-4 md:flex-row md:items-start">
          {faqColumns.map((column) => (
            <div class="flex flex-1 flex-col gap-4">
              {column.map((item) => (
                <details class="group rounded-2xl border border-brand/10 bg-white p-6 shadow-sm">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold text-gray-900 [&::-webkit-details-marker]:hidden">
                    {item.q}
                    <span class="shrink-0 text-brand transition-transform group-open:rotate-45" aria-hidden="true"><Icon name="plus" size={20} /></span>
                  </summary>
                  <p class="mt-4 text-gray-600 leading-relaxed">{item.a}</p>
                </details>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section-alt py-16 md:py-20" aria-labelledby="cta-heading">
      <div class="max-w-3xl mx-auto px-4 text-center">
        <h2 id="cta-heading" class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{details.ctaTitle}</h2>
        <p class="text-lg text-gray-600 mb-8">{details.ctaBody}</p>
        <a href={contact} class="btn-primary" data-open-demo>{ui.cta} →</a>
      </div>
    </section>
  </main>
</Layout>

<script>
  // Tap-to-open glosses for dotted-underline terms. Works on touch, closes on outside tap or Escape.
  const terms = document.querySelectorAll<HTMLButtonElement>('[data-term]');
  const close = (btn: HTMLButtonElement) => {
    btn.setAttribute('aria-expanded', 'false');
    document.getElementById(btn.getAttribute('aria-controls')!)!.hidden = true;
  };
  terms.forEach((btn) => btn.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = btn.getAttribute('aria-expanded') === 'true';
    terms.forEach(close);
    if (!open) {
      btn.setAttribute('aria-expanded', 'true');
      document.getElementById(btn.getAttribute('aria-controls')!)!.hidden = false;
    }
  }));
  document.addEventListener('click', () => terms.forEach(close));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') terms.forEach(close); });

  // Autoplay the short, muted recording on wide screens unless the visitor prefers reduced motion.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video && !matchMedia('(prefers-reduced-motion: reduce)').matches && matchMedia('(min-width: 640px)').matches) {
    video.play().catch(() => {});
  }
</script>
