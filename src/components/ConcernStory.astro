---
import Icon from './Icon.astro';
import { concerns, groups, nodeOrder, nodes, ui as uiCopy, type Lang, type NodeId } from '../data/mkb-concerns';

interface Props { lang: Lang; nodeIds?: NodeId[] }
const { lang, nodeIds = nodeOrder } = Astro.props;
const ui = uiCopy[lang];
const steps = concerns.filter((c) => nodeIds.includes(c.node));
---
<div id="concern-story" data-state="closed" class="fixed inset-x-0 bottom-0 z-40 flex justify-center px-4 sm:px-6 lg:px-8 pointer-events-none">
  <section
    data-sheet
    aria-label={ui.region}
    class="pointer-events-auto w-full max-w-[76rem] rounded-t-2xl bg-white shadow-[0_-8px_30px_rgba(17,28,44,0.18)] ring-1 ring-brand/10 transition-transform duration-300 motion-reduce:transition-none h-[min(70vh,26rem)] sm:h-[min(70vh,30rem)]"
    style="transform: translateY(calc(100% - 3rem));"
  >
    <button
      type="button"
      data-handle
      aria-expanded="false"
      aria-controls="concern-story-body"
      class="flex h-12 w-full cursor-grab touch-none select-none items-center justify-center gap-2 rounded-t-2xl bg-surface-dark font-semibold text-white active:cursor-grabbing"
    >
      <Icon name="grip-horizontal" size={20} />
      {ui.handle}
      <span data-chevron class="transition-transform motion-reduce:transition-none"><Icon name="chevron-up" size={18} /></span>
    </button>

    <div id="concern-story-body" data-body class="flex h-[calc(100%-3rem)] flex-col gap-3 overflow-hidden p-4 sm:p-5" hidden>
      <div>
        <ol class="flex gap-2" aria-label={ui.spine}>
          {nodeIds.map((id, i) => (
            <li class="min-w-0 flex-1" data-spine-node={id}>
              <div class="flex items-center gap-2 border-b-2 border-gray-200 pb-1.5 text-sm font-bold text-text-heading transition-colors" data-spine-label>
                <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-surface-dark text-xs text-white">{i + 1}</span><span class="sr-only truncate sm:not-sr-only">{nodes[id][lang]}</span>
              </div>
              <ul class="mt-2 hidden space-y-1.5 sm:block">
                {steps.map((c, index) => c.node === id && (
                  <li>
                    <button
                      type="button"
                      data-chip={index}
                      class={`w-full rounded-lg border-l-4 bg-surface px-2.5 py-1 text-left text-xs leading-snug text-text hover:bg-brand/10 aria-[current=true]:bg-brand aria-[current=true]:text-white ${groups[c.group].border}`}
                    >{c[lang].concern}</button>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
        <ul class="mt-1 hidden flex-wrap gap-x-4 gap-y-1 text-xs text-text-light sm:flex">
          {Object.values(groups).map((g) => <li class="flex items-center gap-1.5"><span class={`inline-block h-2.5 w-2.5 rounded-full ${g.dot}`}></span>{g.label[lang]}</li>)}
        </ul>
      </div>

      <div class="sm:mt-auto rounded-2xl bg-surface p-4" aria-live="polite">
        <div data-intro>
          <h2 class="mb-1 text-lg font-bold text-text-heading">{ui.introTitle}</h2>
          <p class="mb-4 text-text-light">{ui.intro}</p>
          <button type="button" data-start class="btn-primary !py-2">{ui.start} →</button>
        </div>
        {steps.map((c, index) => (
          <div data-step={index} hidden>
            <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-text-light">{index + 1} / {steps.length} · {ui.shownAt}: {nodes[c.node][lang]}</p>
            <h2 class="mb-2 text-lg font-bold text-text-heading">“{c[lang].concern}”</h2>
            <p class="mb-4 text-text">{c[lang].answer}</p>
            <div class="flex gap-2">
              <button type="button" data-prev class="inline-flex items-center gap-1.5 rounded-full border border-brand px-4 py-1.5 text-sm font-semibold text-brand hover:bg-brand hover:text-white transition-colors"><Icon name="arrow-left" size={16} />{ui.prev}</button>
              {index < steps.length - 1 && <button type="button" data-next class="inline-flex items-center gap-1.5 rounded-full bg-brand px-4 py-1.5 text-sm font-semibold text-white hover:bg-brand-light transition-colors">{ui.next}<Icon name="arrow-right" size={16} /></button>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</div>

<style is:global>
  [data-story-node] { scroll-margin-top: 6rem; }
  .story-hl { outline: 4px solid #FACB3D; outline-offset: 6px; border-radius: 1rem; transition: outline-color 0.3s ease; }
  @media (prefers-reduced-motion: reduce) { .story-hl { transition: none; } }
  [data-spine-node].is-active [data-spine-label] { border-color: #FACB3D; }
  [data-spine-node].is-active [data-spine-label] > span:first-child { box-shadow: 0 0 0 3px #FACB3D; }
</style>

<script>
  const root = document.getElementById('concern-story') as HTMLElement | null;
  if (root) {
    const sheet = root.querySelector<HTMLElement>('[data-sheet]')!;
    const handle = root.querySelector<HTMLButtonElement>('[data-handle]')!;
    const body = root.querySelector<HTMLElement>('[data-body]')!;
    const chevron = root.querySelector<HTMLElement>('[data-chevron]')!;
    const intro = root.querySelector<HTMLElement>('[data-intro]')!;
    const stepEls = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const chips = [...root.querySelectorAll<HTMLElement>('[data-chip]')];
    const HANDLE_H = 48;
    let open = false;
    let current = -1;
    let hl: HTMLElement | null = null;

    const closedOffset = () => sheet.offsetHeight - HANDLE_H;
    const setOpen = (value: boolean) => {
      open = value;
      root.dataset.state = value ? 'open' : 'closed';
      handle.setAttribute('aria-expanded', String(value));
      chevron.style.transform = value ? 'rotate(180deg)' : '';
      sheet.style.transform = value ? 'translateY(0)' : 'translateY(calc(100% - 3rem))';
      body.hidden = !value;
      // Leave room so the last page section can scroll above the sheet.
      document.body.style.paddingBottom = value ? `${sheet.offsetHeight}px` : '';
      if (!value) clearHighlight();
    };

    const clearHighlight = () => { hl?.classList.remove('story-hl'); hl = null; };
    const show = (index: number) => {
      current = index;
      intro.hidden = index >= 0;
      stepEls.forEach((el, i) => { el.hidden = i !== index; });
      chips.forEach((chip, i) => chip.setAttribute('aria-current', String(i === index)));
      root.querySelectorAll('[data-spine-node]').forEach((n) => n.classList.remove('is-active'));
      clearHighlight();
      if (index < 0) return;
      const node = (chips[index].closest('[data-spine-node]') as HTMLElement).dataset.spineNode!;
      root.querySelector(`[data-spine-node="${node}"]`)?.classList.add('is-active');
      const target = document.querySelector<HTMLElement>(`[data-story-node="${node}"]`);
      if (target) {
        hl = target;
        target.classList.add('story-hl');
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      }
    };

    // Click toggles; dragging the handle moves the sheet and snaps open/closed past ~30% travel.
    let startY = 0, startOffset = 0, dragging = false, moved = false;
    handle.addEventListener('pointerdown', (e) => {
      // Stop the browser starting a native link/text drag, which would cancel this pointer drag.
      e.preventDefault();
      dragging = true; moved = false; startY = e.clientY;
      startOffset = open ? 0 : closedOffset();
      handle.setPointerCapture(e.pointerId);
      sheet.style.transition = 'none';
    });
    handle.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dy = e.clientY - startY;
      if (Math.abs(dy) > 5) moved = true;
      if (!moved) return;
      body.hidden = false;
      const offset = Math.min(closedOffset(), Math.max(0, startOffset + dy));
      sheet.style.transform = `translateY(${offset}px)`;
    });
    const endDrag = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      sheet.style.transition = '';
      if (handle.hasPointerCapture(e.pointerId)) handle.releasePointerCapture(e.pointerId);
      if (!moved) { setOpen(!open); return; }
      const travel = e.clientY - startY;
      const threshold = closedOffset() * 0.3;
      setOpen(open ? travel < threshold : -travel > threshold);
    };
    document.addEventListener('dragstart', (e) => { if (dragging) e.preventDefault(); });
    handle.addEventListener('pointerup', endDrag);
    handle.addEventListener('pointercancel', endDrag);
    // Pointer events cover mouse and touch; keyboard Enter/Space fire click with detail 0.
    handle.addEventListener('click', (e) => { if (e.detail === 0) setOpen(!open); });

    root.querySelector('[data-start]')?.addEventListener('click', () => show(0));
    chips.forEach((chip, i) => chip.addEventListener('click', () => show(i)));
    root.querySelectorAll('[data-next]').forEach((b) => b.addEventListener('click', () => show(Math.min(current + 1, stepEls.length - 1))));
    root.querySelectorAll('[data-prev]').forEach((b) => b.addEventListener('click', () => show(current > 0 ? current - 1 : -1)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && open) { setOpen(false); handle.focus(); } });
  }
</script>
