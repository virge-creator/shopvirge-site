---
// LinkedIn and Discord shortcuts for the contact pages. `hero` renders two pill buttons
// for the dark hero; `cards` renders larger cards for the light sidebar.
interface Props { lang: 'en' | 'nl'; variant: 'hero' | 'cards' }
const { lang, variant } = Astro.props;
const en = lang === 'en';
const linkedin = 'https://www.linkedin.com/in/renedohmen/';
const discord = 'https://discord.gg/dZG9kRSSH3';
const t = en ? {
  linkedinCta: 'Message René on LinkedIn',
  discordCta: 'Join our Discord',
  heading: 'Prefer a quick chat?',
  linkedinTitle: 'René Dohmen on LinkedIn',
  linkedinBody: 'Founder of ShopVirge. Send a connection request or a message. No form needed.',
  discordTitle: 'ShopVirge Discord community',
  discordBody: 'Ask questions, share ideas and talk with our team and other shop owners.',
} : {
  linkedinCta: 'Stuur René een bericht op LinkedIn',
  discordCta: 'Word lid van onze Discord',
  heading: 'Liever even snel contact?',
  linkedinTitle: 'René Dohmen op LinkedIn',
  linkedinBody: 'Oprichter van ShopVirge. Stuur een connectieverzoek of een bericht. Geen formulier nodig.',
  discordTitle: 'ShopVirge Discord-community',
  discordBody: 'Stel je vragen, deel ideeën en praat met ons team en andere webshophouders.',
};
// Brand marks are not in lucide-static, so they are inlined.
const linkedinPath = 'M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z';
const discordPath = 'M20.32 4.37a19.8 19.8 0 0 0-4.89-1.52.07.07 0 0 0-.08.04c-.21.38-.44.87-.61 1.26a18.27 18.27 0 0 0-5.49 0 12.64 12.64 0 0 0-.62-1.26.08.08 0 0 0-.08-.04 19.74 19.74 0 0 0-4.88 1.52.07.07 0 0 0-.03.03C.53 9.05-.32 13.58.1 18.06a.08.08 0 0 0 .03.06 19.9 19.9 0 0 0 5.99 3.03.08.08 0 0 0 .08-.03c.46-.63.87-1.3 1.23-1.99a.08.08 0 0 0-.04-.11 13.1 13.1 0 0 1-1.87-.89.08.08 0 0 1-.01-.13l.37-.29a.07.07 0 0 1 .08-.01c3.93 1.79 8.18 1.79 12.07 0a.07.07 0 0 1 .08.01l.37.29a.08.08 0 0 1-.01.13c-.6.35-1.22.65-1.87.89a.08.08 0 0 0-.04.11c.36.7.78 1.36 1.23 1.99a.08.08 0 0 0 .08.03 19.84 19.84 0 0 0 6-3.03.08.08 0 0 0 .03-.06c.5-5.18-.84-9.67-3.55-13.66a.06.06 0 0 0-.03-.03ZM8.02 15.33c-1.18 0-2.16-1.09-2.16-2.42 0-1.33.96-2.42 2.16-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.33-.96 2.42-2.16 2.42Zm7.97 0c-1.18 0-2.15-1.09-2.15-2.42 0-1.33.95-2.42 2.15-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.33-.95 2.42-2.16 2.42Z';
---
{variant === 'hero' ? (
  <div class="mt-8 flex flex-wrap gap-3">
    <a href={linkedin} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-[#0A66C2] px-5 py-3 font-semibold text-white shadow-lg hover:bg-[#004182] transition-colors">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={linkedinPath} /></svg>{t.linkedinCta}
    </a>
    <a href={discord} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-[#5865F2] px-5 py-3 font-semibold text-white shadow-lg hover:bg-[#4752C4] transition-colors">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={discordPath} /></svg>{t.discordCta}
    </a>
  </div>
) : (
  <div>
    <h3 class="text-lg font-bold mb-4">{t.heading}</h3>
    <div class="grid gap-4 sm:grid-cols-2">
      <a href={linkedin} target="_blank" rel="noopener" class="group flex flex-col rounded-xl border border-[#0A66C2]/20 bg-[#0A66C2]/5 p-5 hover:border-[#0A66C2] hover:shadow-md transition">
        <span class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-[#0A66C2] text-white"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d={linkedinPath} /></svg></span>
        <span class="font-bold text-gray-900">{t.linkedinTitle}</span>
        <span class="mt-1 text-sm text-gray-600">{t.linkedinBody}</span>
        <span class="mt-3 text-sm font-semibold text-[#0A66C2] group-hover:underline">{t.linkedinCta} →</span>
      </a>
      <a href={discord} target="_blank" rel="noopener" class="group flex flex-col rounded-xl border border-[#5865F2]/20 bg-[#5865F2]/5 p-5 hover:border-[#5865F2] hover:shadow-md transition">
        <span class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-[#5865F2] text-white"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d={discordPath} /></svg></span>
        <span class="font-bold text-gray-900">{t.discordTitle}</span>
        <span class="mt-1 text-sm text-gray-600">{t.discordBody}</span>
        <span class="mt-3 text-sm font-semibold text-[#5865F2] group-hover:underline">{t.discordCta} →</span>
      </a>
    </div>
  </div>
)}
