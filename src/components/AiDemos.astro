---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';

interface Props { lang: 'en' | 'nl' }
const { lang } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL;
const videoBase = `${base}videos/ai-demos/`;
const contact = `${base}${lang}/contact/?type=demo`;
const socialImage = `https://shopvirge.com${videoBase}shop-wide.webp`;
const stepIcons = ['image-up', 'sparkles', 'package-plus', 'clipboard-check'];
const painIcons = ['keyboard', 'folder-tree', 'clock'];

const copy = en ? {
  title: 'AI product listing demos for your webshop',
  description: 'Watch ShopVirge AI product demos: see a connected assistant create webshop listings and product descriptions from a photo or a list of item numbers.',
  eyebrow: 'ShopVirge in action',
  hero: 'From product photo to <span class="text-amber-400">webshop listing</span>',
  intro: 'Share a photo or a few item numbers with a connected AI assistant. It drafts the product details and creates the listing in your ShopVirge shop, ready for you to check.',
  heroCaption: 'Screen recording · photo demo · waiting time cut',
  videoFallback: 'Your browser does not support video playback.',
  pick: 'Pick your situation',
  discuss: 'Discuss your shop',
  problemTitle: 'Adding products is the slow part of selling online',
  problemIntro: 'Especially with second-hand or one-off stock, every item needs its own work before it can go online.',
  pains: [
    { title: 'Typing every description', detail: 'Name, specifications and a readable description, item by item.' },
    { title: 'Choosing categories', detail: 'Deciding where each product belongs so customers can find it.' },
    { title: 'Stock waits offline', detail: 'Items you could sell sit on a shelf until someone has time to list them.' },
  ],
  pickTitle: 'What do you start with?',
  pickIntro: 'Choose the situation closest to yours. Each demo is a short, real screen recording from a ShopVirge demo shop.',
  demos: [
    {
      id: 'photo', icon: 'camera', label: 'I have the item, but no description',
      title: 'From a product photo',
      detail: 'A photo of a second-hand power supply. The assistant identifies it, writes the details and adds it to the shop.',
      result: 'One product with name, description, photo and category',
      video: 'shop',
      href: `${base}en/ai-demos/photo/`,
    },
    {
      id: 'lego', icon: 'list-ordered', label: 'I have item or set numbers',
      title: 'From a list of item numbers',
      detail: 'Five LEGO set numbers in one request. The assistant looks up each set and creates all five products.',
      result: 'Five products with images, details and categories',
      video: 'lego',
      href: `${base}en/ai-demos/lego/`,
    },
  ],
  resultLabel: 'Result',
  viewDemo: 'Watch this demo',
  flowTitle: 'What happens in both demos',
  flowIntro: 'You give the assistant what you have. You stay in charge of what goes live.',
  steps: [
    { title: 'You provide the basics', detail: 'A photo, a product code or a list of item numbers.' },
    { title: 'The assistant prepares', detail: 'It gathers details and drafts the product information.' },
    { title: 'ShopVirge creates products', detail: 'Listings and categories are added to the shop.' },
    { title: 'You review the result', detail: 'Check the products in your storefront and change what you need.' },
  ],
  faqTitle: 'Questions sellers ask',
  faq: [
    { q: 'Is this included in every ShopVirge plan?', a: 'The recordings show a connected AI assistant working with a ShopVirge demo shop. Whether and how this fits your shop is something we work out together, so ask us during a demo.' },
    { q: 'Are the recordings sped up?', a: 'The waiting time while the assistant works has been cut so the recordings stay short. The steps and the results in the shop are as recorded.' },
    { q: 'Do I still need to check the products?', a: 'Yes. The assistant gives you a strong first draft, but you know your stock. Check condition, specifications, price and category before you sell.' },
    { q: 'Does it import my Marktplaats or 2dehands listings?', a: 'Yes, we can set that up for your shop. The LEGO demo starts from typed set numbers, but importing your existing Marktplaats or 2dehands listings is possible. Ask us about it in a demo.' },
    { q: 'Can I see it with my own products?', a: 'Yes, that is the best way to judge it. Bring a few photos or item numbers to a demo and we will look at them with you.' },
  ],
  ctaTitle: 'See it with your own products',
  ctaBody: 'Tell us how you add products today and bring a few photos or item numbers. We will show you where ShopVirge and a connected assistant could save you time.',
  ctaButton: 'Request a demo',
} : {
  title: 'AI-productdemo’s: producten toevoegen aan je webshop',
  description: 'Bekijk hoe je met een gekoppelde AI-assistent producten aan een webshop toevoegt: van productfoto of artikelnummers naar productbeschrijvingen en vermeldingen.',
  eyebrow: 'ShopVirge in actie',
  hero: 'Van productfoto naar <span class="text-amber-400">product in je webshop</span>',
  intro: 'Deel een foto of een paar artikelnummers met een gekoppelde AI-assistent. Die stelt de productgegevens op en maakt het product aan in je ShopVirge-shop, klaar om te controleren.',
  heroCaption: 'Schermopname · fotodemo · wachttijd ingekort',
  videoFallback: 'Je browser ondersteunt het afspelen van video niet.',
  pick: 'Kies jouw situatie',
  discuss: 'Bespreek jouw shop',
  problemTitle: 'Producten toevoegen is het trage deel van online verkopen',
  problemIntro: 'Zeker bij tweedehands of unieke voorraad vraagt elk artikel eigen werk voordat het online kan.',
  pains: [
    { title: 'Elke beschrijving uittypen', detail: 'Naam, specificaties en een leesbare tekst, artikel voor artikel.' },
    { title: 'Categorieën kiezen', detail: 'Bepalen waar elk product hoort, zodat klanten het vinden.' },
    { title: 'Voorraad blijft offline', detail: 'Artikelen die je kunt verkopen liggen op de plank tot iemand tijd heeft.' },
  ],
  pickTitle: 'Waar begin jij mee?',
  pickIntro: 'Kies de situatie die het meest op de jouwe lijkt. Elke demo is een korte, echte schermopname uit een ShopVirge-demoshop.',
  demos: [
    {
      id: 'photo', icon: 'camera', label: 'Ik heb het artikel, maar geen tekst',
      title: 'Van een productfoto',
      detail: 'Een foto van een tweedehands computervoeding. De assistent herkent het artikel, schrijft de gegevens en voegt het toe aan de shop.',
      result: 'Eén product met naam, beschrijving, foto en categorie',
      video: 'shop',
      href: `${base}nl/ai-demos/photo/`,
    },
    {
      id: 'lego', icon: 'list-ordered', label: 'Ik heb artikel- of setnummers',
      title: 'Van een lijst artikelnummers',
      detail: 'Vijf LEGO-setnummers in één verzoek. De assistent zoekt elke set op en maakt alle vijf producten aan.',
      result: 'Vijf producten met afbeeldingen, details en categorieën',
      video: 'lego',
      href: `${base}nl/ai-demos/lego/`,
    },
  ],
  resultLabel: 'Resultaat',
  viewDemo: 'Bekijk deze demo',
  flowTitle: 'Wat er in beide demo’s gebeurt',
  flowIntro: 'Je geeft de assistent wat je hebt. Jij bepaalt wat er online komt.',
  steps: [
    { title: 'Jij geeft de basis', detail: 'Een foto, productcode of lijst met artikelnummers.' },
    { title: 'De assistent bereidt voor', detail: 'Hij zoekt details op en stelt productinformatie samen.' },
    { title: 'ShopVirge maakt producten', detail: 'Producten en categorieën verschijnen in de shop.' },
    { title: 'Jij controleert het resultaat', detail: 'Bekijk de producten in je webshop en pas aan wat nodig is.' },
  ],
  faqTitle: 'Vragen die verkopers stellen',
  faq: [
    { q: 'Zit dit in elk ShopVirge-abonnement?', a: 'De opnames tonen een gekoppelde AI-assistent in een ShopVirge-demoshop. Of en hoe dit bij jouw shop past, bekijken we samen. Vraag het tijdens een demo.' },
    { q: 'Zijn de opnames versneld?', a: 'De wachttijd terwijl de assistent werkt is eruit geknipt, zodat de opnames kort blijven. De stappen en het resultaat in de shop zijn zoals opgenomen.' },
    { q: 'Moet ik de producten nog controleren?', a: 'Ja. De assistent levert een goede eerste versie, maar jij kent je voorraad. Controleer staat, specificaties, prijs en categorie voordat je verkoopt.' },
    { q: 'Importeert dit mijn advertenties van Marktplaats of 2dehands?', a: 'Ja, dat kunnen we voor je shop inrichten. De LEGO-demo begint met ingetypte setnummers, maar je bestaande advertenties van Marktplaats of 2dehands importeren is mogelijk. Vraag ernaar tijdens een demo.' },
    { q: 'Kan ik het zien met mijn eigen producten?', a: 'Ja, zo beoordeel je het het best. Neem een paar foto’s of artikelnummers mee naar een demo, dan bekijken we ze samen.' },
  ],
  ctaTitle: 'Bekijk het met je eigen producten',
  ctaBody: 'Vertel ons hoe je nu producten toevoegt en neem een paar foto’s of artikelnummers mee. We laten zien waar ShopVirge en een gekoppelde assistent je tijd kunnen besparen.',
  ctaButton: 'Vraag een demo aan',
};
---
<Layout title={copy.title} description={copy.description} lang={lang} image={socialImage}>
  <section class="hero text-white py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-10 lg:grid-cols-12 lg:gap-12 items-center">
      <div class="lg:col-span-5">
        <span class="inline-flex items-center rounded-full bg-white/20 px-4 py-1.5 text-sm font-semibold mb-6">{copy.eyebrow}</span>
        <h1 class="text-4xl md:text-5xl font-extrabold leading-tight mb-6" set:html={copy.hero} />
        <p class="text-lg md:text-xl text-white/85 leading-relaxed mb-9">{copy.intro}</p>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary bg-white text-brand hover:bg-gray-100" href="#examples">{copy.pick} ↓</a>
          <a class="inline-flex items-center justify-center rounded-full border border-white/60 px-6 py-3 font-semibold text-white hover:bg-white/10 transition-colors" href={contact} data-open-demo>{copy.discuss} →</a>
        </div>
      </div>
      <figure class="lg:col-span-7 rounded-2xl bg-surface-dark p-2 sm:p-3 shadow-2xl">
        <video class="hidden sm:block w-full rounded-xl bg-black aspect-video" data-hero-video muted loop playsinline controls preload="metadata" poster={`${videoBase}shop-wide-result.webp`} aria-label={copy.demos[0].title}>
          <source src={`${videoBase}shop-wide.mp4#t=10`} type="video/mp4" />{copy.videoFallback}
        </video>
        <video class="sm:hidden w-full rounded-xl bg-black aspect-[9/16] max-h-[65vh] object-contain" muted loop playsinline controls preload="none" poster={`${videoBase}shop-vertical.webp`} aria-label={copy.demos[0].title}>
          <source src={`${videoBase}shop-vertical.mp4`} type="video/mp4" />{copy.videoFallback}
        </video>
        <figcaption class="px-2 pt-3 pb-1 text-white/70 text-xs font-medium">{copy.heroCaption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="py-16 md:py-20" aria-labelledby="problem-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-10">
        <h2 id="problem-heading" class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{copy.problemTitle}</h2>
        <p class="text-lg text-gray-600">{copy.problemIntro}</p>
      </div>
      <ul class="grid gap-5 md:grid-cols-3">
        {copy.pains.map((pain, index) => (
          <li class="flex gap-4 rounded-2xl border border-brand/10 bg-surface p-6">
            <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent"><Icon name={painIcons[index]} size={22} /></span>
            <div>
              <h3 class="font-bold text-gray-900 mb-1">{pain.title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{pain.detail}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="examples" class="section-alt py-20 md:py-24 scroll-mt-16" aria-labelledby="examples-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <h2 id="examples-heading" class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{copy.pickTitle}</h2>
        <p class="text-lg text-gray-600 leading-relaxed">{copy.pickIntro}</p>
      </div>
      <div class="grid gap-8 lg:grid-cols-2">
        {copy.demos.map((demo) => (
          <a id={demo.id} href={demo.href} class="group flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm hover:shadow-xl transition-shadow focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-brand">
            <div class="relative bg-surface-dark">
              <img class="w-full aspect-video object-cover opacity-90 group-hover:opacity-100 transition-opacity" src={`${videoBase}${demo.video}-wide.webp`} alt="" loading="lazy" />
              <span aria-hidden="true" class="absolute inset-0 flex items-center justify-center">
                <span class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-white/90 text-brand shadow-lg group-hover:scale-110 transition-transform"><Icon name="play" size={28} /></span>
              </span>
            </div>
            <div class="flex flex-1 flex-col p-7 md:p-8">
              <span class="inline-flex items-center gap-2 self-start rounded-full bg-brand/10 px-3 py-1 text-sm font-semibold text-brand mb-4"><Icon name={demo.icon} size={16} />{demo.label}</span>
              <h3 class="text-2xl font-bold text-gray-900 mb-3">{demo.title}</h3>
              <p class="text-gray-600 leading-relaxed mb-5">{demo.detail}</p>
              <p class="border-l-4 border-accent-secondary pl-4 text-gray-800 font-medium mb-6"><span class="sr-only">{copy.resultLabel}: </span>{demo.result}</p>
              <span class="mt-auto font-semibold text-brand group-hover:text-brand-dark">{copy.viewDemo} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-24" aria-labelledby="flow-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <h2 id="flow-heading" class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{copy.flowTitle}</h2>
        <p class="text-lg text-gray-600">{copy.flowIntro}</p>
      </div>
      <ol class="grid gap-8 md:grid-cols-4 md:gap-5" aria-label={copy.flowTitle}>
        {copy.steps.map((step, index) => (
          <li class="relative min-w-0 rounded-2xl bg-white border border-brand/10 shadow-sm">
            <div class={`relative flex h-32 items-center justify-center rounded-t-2xl ${index % 2 === 0 ? 'bg-brand/5' : 'bg-accent/10'}`}>
              <Icon name={stepIcons[index]} size={76} class={index % 2 === 0 ? 'text-brand/30' : 'text-accent/30'} />
              <span class={`absolute left-5 top-5 inline-flex h-9 w-9 items-center justify-center rounded-xl text-sm font-bold ${index % 2 === 0 ? 'bg-brand/10 text-brand' : 'bg-accent/10 text-accent'}`}>{index + 1}</span>
            </div>
            <div class="p-6">
              <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{step.detail}</p>
            </div>
            {index < 3 && <span aria-hidden="true" class="absolute -bottom-6 left-1/2 z-10 flex h-8 w-8 -translate-x-1/2 rotate-90 items-center justify-center rounded-full bg-brand-light text-white shadow-md md:-right-6 md:bottom-auto md:left-auto md:top-14 md:translate-x-0 md:rotate-0">→</span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-alt py-20 md:py-24" aria-labelledby="faq-heading">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="faq-heading" class="text-3xl md:text-4xl font-bold text-gray-900 mb-10">{copy.faqTitle}</h2>
      <div class="space-y-4">
        {copy.faq.map((item) => (
          <details class="group rounded-2xl bg-white p-6 shadow-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold text-gray-900 [&::-webkit-details-marker]:hidden">
              {item.q}
              <span class="shrink-0 text-brand transition-transform group-open:rotate-45" aria-hidden="true"><Icon name="plus" size={20} /></span>
            </summary>
            <p class="mt-4 text-gray-600 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{copy.ctaTitle}</h2>
      <p class="text-lg text-gray-600 mb-8">{copy.ctaBody}</p>
      <a href={contact} class="btn-primary" data-open-demo>{copy.ctaButton} →</a>
    </div>
  </section>
</Layout>

<script>
  // Autoplay the short, muted hero loop on wide screens unless the visitor prefers reduced motion.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video && !matchMedia('(prefers-reduced-motion: reduce)').matches && matchMedia('(min-width: 640px)').matches) {
    video.play().catch(() => {});
  }
</script>
