---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Contact - Neem contact op" description="Neem contact op met ShopVirge. Start een gratis trial, vraag een demo aan of stel je vraag. We reageren binnen 24 uur." lang="nl">
  <section class="hero text-white py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-extrabold mb-6">Contact</h1>
        <p class="text-xl text-white/80">
          Start een gratis trial, vraag een demo aan, of stel je vraag. We reageren binnen 24 uur.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <!-- Type selector tabs -->
          <div class="flex flex-wrap gap-2 mb-8" id="contact-tabs">
            <button data-tab="trial" class="tab-btn active">
              Gratis trial
            </button>
            <button data-tab="demo" class="tab-btn">
              Demo aanvragen
            </button>
            <button data-tab="migration-scan" class="tab-btn">
              Migratie-scan
            </button>
            <button data-tab="general" class="tab-btn">
              Algemene vraag
            </button>
          </div>

          <!-- Trial info box -->
          <div id="info-trial" class="info-box bg-brand/5 border border-brand/20 rounded-xl p-5 mb-6">
            <h3 class="font-bold text-brand mb-2 flex items-center gap-2">
              <Icon name="rocket" size={18} class="text-brand" /> Gratis trial: 14 dagen
            </h3>
            <p class="text-sm text-gray-600 mb-3">
              Test ShopVirge 14 dagen gratis. Je krijgt toegang tot het volledige platform inclusief:
            </p>
            <ul class="text-sm text-gray-600 space-y-1">
              <li class="flex items-center gap-2"><span class="text-brand">✓</span> Je eigen shop-omgeving</li>
              <li class="flex items-center gap-2"><span class="text-brand">✓</span> Tot 25 testproducten</li>
              <li class="flex items-center gap-2"><span class="text-brand">✓</span> 1 taal (extra talen na upgrade)</li>
              <li class="flex items-center gap-2"><span class="text-brand">✓</span> Volledige API &amp; MCP-toegang</li>
              <li class="flex items-center gap-2"><span class="text-brand">✓</span> Geen creditcard nodig</li>
            </ul>
          </div>

          <!-- Demo info box -->
          <div id="info-demo" class="info-box bg-amber-50 border border-amber-200 rounded-xl p-5 mb-6 hidden">
            <h3 class="font-bold text-amber-700 mb-2 flex items-center gap-2">
              <Icon name="monitor-play" size={18} class="text-amber-600" /> Persoonlijke demo
            </h3>
            <p class="text-sm text-gray-600">
              We plannen een 30-minuten videocall waarin we je het platform laten zien, 
              je vragen beantwoorden en samen kijken welk abonnement past bij jouw situatie.
            </p>
          </div>

          <!-- Migration scan info box -->
          <div id="info-migration-scan" class="info-box bg-emerald-50 border border-emerald-200 rounded-xl p-5 mb-6 hidden">
            <h3 class="font-bold text-emerald-700 mb-2 flex items-center gap-2">
              <Icon name="route" size={18} class="text-emerald-600" /> Gratis migratie-scan
            </h3>
            <p class="text-sm text-gray-600">
              Zit je vast op Magento, Shopify of WooCommerce? We berekenen je exacte TCO-besparing en
              leveren een SEO-veilig migratieplan. Vertel ons hieronder je huidige platform en je shop-URL.
            </p>
          </div>

          <!-- General info box -->
          <div id="info-general" class="info-box bg-gray-50 border border-gray-200 rounded-xl p-5 mb-6 hidden">
            <h3 class="font-bold text-gray-700 mb-2 flex items-center gap-2">
              <Icon name="message-circle" size={18} class="text-gray-500" /> Stel je vraag
            </h3>
            <p class="text-sm text-gray-600">
              Heb je een vraag over het platform, de prijzen, of wil je weten of ShopVirge bij jouw business past? 
              We helpen je graag.
            </p>
          </div>

          <form action="https://formspree.io/f/mkokrkdl" method="POST" class="space-y-4">
            <input type="hidden" name="_subject" id="form-subject" value="Nieuwe trial aanvraag - ShopVirge" />
            <input type="hidden" name="type" id="form-type" value="trial" />
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Naam *</label>
                <input type="text" name="name" required 
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Bedrijfsnaam</label>
                <input type="text" name="company"
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none" />
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">E-mail *</label>
              <input type="email" name="email" required 
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Telefoon</label>
              <input type="tel" name="phone"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none" />
            </div>

            <!-- Trial-specific field -->
            <div id="field-trial" class="trial-field">
              <label class="block text-sm font-medium text-gray-700 mb-1">Wat wil je verkopen? *</label>
              <textarea name="trial_description" rows="3" id="trial-textarea"
                placeholder="Bijv. handgemaakte sieraden, biologische cosmetica, vintage kleding..."
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none resize-none"></textarea>
              <p class="text-xs text-gray-400 mt-1">Zo kunnen wij alvast je shop-omgeving klaarzetten.</p>
            </div>

            <!-- Trial: estimated products -->
            <div id="field-products" class="trial-field">
              <label class="block text-sm font-medium text-gray-700 mb-1">Hoeveel producten (bij benadering)?</label>
              <select name="estimated_products" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none bg-white">
                <option value="1-25">1 – 25 producten</option>
                <option value="25-100">25 – 100 producten</option>
                <option value="100-300">100 – 300 producten</option>
                <option value="300+">300+ producten</option>
              </select>
            </div>

            <!-- General message field -->
            <div id="field-message" class="general-field hidden">
              <label class="block text-sm font-medium text-gray-700 mb-1">Bericht *</label>
              <textarea name="message" rows="5" id="message-textarea"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none resize-none"></textarea>
            </div>

            <button type="submit" id="submit-btn" class="btn-primary w-full">Start gratis trial →</button>
          </form>
        </div>

        <div class="space-y-8">
          <div>
            <h3 class="text-lg font-bold mb-4">Direct contact</h3>
            <div class="space-y-3 text-gray-600">
              <p class="flex items-center gap-3">
                <span class="text-brand font-bold">✆</span>
                <a href="tel:+31495794123" class="hover:text-brand transition-colors">+31 495 794 123</a>
              </p>
              <p class="flex items-center gap-3">
                <span class="text-brand font-bold">✉</span>
                <a href="mailto:support@shopvirge.com" class="hover:text-brand transition-colors">support@shopvirge.com</a>
              </p>
            </div>
          </div>
          <div>
            <h3 class="text-lg font-bold mb-4">Bezoek ons</h3>
            <address class="text-gray-600 not-italic leading-relaxed">
              <strong>ShopVirge</strong><br />
              Julianastraat 63<br />
              6039 AH Stramproy<br />
              Nederland
            </address>
          </div>
          <div class="map-card h-80">
            <iframe
              class="map-card__frame"
              src="https://maps.google.com/maps?q=Julianastraat%2063%2C%206039%20AH%20Stramproy&z=15&output=embed"
              title="Kaart: ShopVirge, Julianastraat 63, Stramproy"
              allowfullscreen loading="lazy"
              referrerpolicy="no-referrer-when-downgrade">
            </iframe>
            <span class="map-card__badge"><span class="map-card__dot"></span> Bezoek ons hier</span>
            <div class="map-card__info">
              <div class="map-card__info-text">
                <p class="map-card__info-title">ShopVirge</p>
                <p class="map-card__info-sub">Julianastraat 63, Stramproy</p>
              </div>
              <a class="map-card__btn"
                href="https://www.google.com/maps/dir/?api=1&destination=Julianastraat+63%2C+6039+AH+Stramproy"
                target="_blank" rel="noopener">
                <Icon name="navigation" size={15} class="text-white" /> Route
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.tab-btn');
    const infoBoxes = document.querySelectorAll('.info-box');
    const trialFields = document.querySelectorAll('.trial-field');
    const generalFields = document.querySelectorAll('.general-field');
    const formType = document.getElementById('form-type') as HTMLInputElement;
    const formSubject = document.getElementById('form-subject') as HTMLInputElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const trialTextarea = document.getElementById('trial-textarea') as HTMLTextAreaElement;
    const messageTextarea = document.getElementById('message-textarea') as HTMLTextAreaElement;

    const subjects: Record<string, string> = {
      trial: 'Nieuwe trial aanvraag - ShopVirge',
      demo: 'Demo aanvraag - ShopVirge',
      'migration-scan': 'Migratie-scan aanvraag - ShopVirge',
      general: 'Contactbericht - ShopVirge'
    };
    const buttons: Record<string, string> = {
      trial: 'Start gratis trial →',
      demo: 'Demo aanvragen →',
      'migration-scan': 'Vraag migratie-scan aan →',
      general: 'Verstuur bericht →'
    };

    // Check URL param
    const params = new URLSearchParams(window.location.search);
    const initialTab = params.get('type') || 'trial';

    function activate(tab: string) {
      tabs.forEach(t => t.classList.remove('active'));
      document.querySelector(`[data-tab="${tab}"]`)?.classList.add('active');

      infoBoxes.forEach(b => b.classList.add('hidden'));
      document.getElementById(`info-${tab}`)?.classList.remove('hidden');

      const isTrial = tab === 'trial';
      const isGeneral = tab === 'general';
      const isMigration = tab === 'migration-scan';
      trialFields.forEach(f => f.classList.toggle('hidden', !isTrial));
      generalFields.forEach(f => f.classList.toggle('hidden', isTrial));

      if (isTrial) {
        trialTextarea?.setAttribute('required', '');
        messageTextarea?.removeAttribute('required');
      } else if (isGeneral || isMigration) {
        messageTextarea?.setAttribute('required', '');
        trialTextarea?.removeAttribute('required');
      } else {
        trialTextarea?.removeAttribute('required');
        messageTextarea?.removeAttribute('required');
      }

      formType.value = tab;
      formSubject.value = subjects[tab] || subjects.general;
      submitBtn.textContent = buttons[tab] || buttons.general;
    }

    tabs.forEach(t => t.addEventListener('click', () => {
      activate((t as HTMLElement).dataset.tab || 'trial');
    }));

    activate(initialTab);
  });
</script>
