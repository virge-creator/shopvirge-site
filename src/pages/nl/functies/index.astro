---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Functies — Alles wat je nodig hebt" lang="nl">
  <section class="hero text-white py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-extrabold mb-6">Functies</h1>
        <p class="text-xl text-white/80">
          Alles wat je nodig hebt om een professionele, meertalige webshop of portfolio te lanceren.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-24">

      <!-- Meertalig -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="w-14 h-14 bg-brand/10 rounded-2xl flex items-center justify-center mb-6">
            <Icon name="globe" size={28} class="text-brand" />
          </div>
          <h2 class="text-3xl font-bold mb-4">Automatisch meertalig</h2>
          <p class="text-gray-600 mb-4">
            Vertalen was nog nooit zo makkelijk. Jouw hele site wordt automatisch vertaald 
            in de talen die jij kiest: producten, categorieën, pagina's en metadata.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Nederlands, Engels, Duits, Frans, Spaans en meer</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> SEO- en GEO-geoptimaliseerde vertalingen per taal</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Handmatige aanpassingen altijd mogelijk</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Automatische taaldetectie voor bezoekers</li>
          </ul>
        </div>
        <div class="bg-brand/5 rounded-2xl p-12 flex items-center justify-center">
          <Icon name="languages" size={96} class="text-brand/30" />
        </div>
      </div>

      <!-- Snel live -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="md:order-2">
          <div class="w-14 h-14 bg-accent/10 rounded-2xl flex items-center justify-center mb-6">
            <Icon name="zap" size={28} class="text-accent" />
          </div>
          <h2 class="text-3xl font-bold mb-4">Snel live, zonder gedoe</h2>
          <p class="text-gray-600 mb-4">
            Van concept tot volledig live site in minder dan een uur. 
            Upload je producten handmatig, of importeer ze direct vanuit een Excel-bestand.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Stap-voor-stap begeleiding</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Productimport vanuit Excel of CSV</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Drag-and-drop afbeelding uploads</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Automatische sitemap, SEO en GEO-tags</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Publiceer met één klik</li>
          </ul>
        </div>
        <div class="bg-accent/10 rounded-2xl p-12 flex items-center justify-center md:order-1">
          <Icon name="rocket" size={96} class="text-accent/30" />
        </div>
      </div>

      <!-- Betalingen via Stripe -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="w-14 h-14 bg-brand/10 rounded-2xl flex items-center justify-center mb-6">
            <Icon name="credit-card" size={28} class="text-brand" />
          </div>
          <h2 class="text-3xl font-bold mb-4">Betalingen via Stripe</h2>
          <p class="text-gray-600 mb-4">
            Stripe is volledig geïntegreerd. Accepteer alle gangbare betaalmethoden 
            zonder extra plugins of maatwerk. Wij helpen je met de Stripe-configuratie.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> iDEAL en Bancontact</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Creditcard (Visa, Mastercard, Amex)</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> PayPal</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Automatische facturen en bonnetjes</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Webhook-notificaties bij elke bestelling</li>
          </ul>
        </div>
        <div class="bg-brand/5 rounded-2xl p-12 flex items-center justify-center">
          <Icon name="wallet" size={96} class="text-brand/30" />
        </div>
      </div>

      <!-- Mobiel -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="md:order-2">
          <div class="w-14 h-14 bg-accent/10 rounded-2xl flex items-center justify-center mb-6">
            <Icon name="smartphone" size={28} class="text-accent" />
          </div>
          <h2 class="text-3xl font-bold mb-4">Mobiel-first design</h2>
          <p class="text-gray-600 mb-4">
            Elke site ziet er perfect uit op telefoon, tablet en desktop. 
            Geoptimaliseerd voor snelheid en conversie.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Responsive op elk schermformaat</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Supersnel (&lt; 1s laadtijd)</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Touch-geoptimaliseerde navigatie</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Werkt ook offline als app op je telefoon</li>
          </ul>
        </div>
        <div class="bg-accent/10 rounded-2xl p-12 flex items-center justify-center md:order-1">
          <Icon name="tablet-smartphone" size={96} class="text-accent/30" />
        </div>
      </div>

      <!-- Design -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="w-14 h-14 bg-brand/10 rounded-2xl flex items-center justify-center mb-6">
            <Icon name="palette" size={28} class="text-brand" />
          </div>
          <h2 class="text-3xl font-bold mb-4">Geen design-skills nodig</h2>
          <p class="text-gray-600 mb-4">
            Professioneel ogende websites uit de doos. 
            Kies uit kant-en-klare templates en pas ze aan met je eigen merk-kleuren.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> 20+ professionele templates</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Eigen kleuren, fonts en logo</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Custom CSS mogelijk</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Dark mode ondersteuning</li>
          </ul>
        </div>
        <div class="bg-brand/5 rounded-2xl p-12 flex items-center justify-center">
          <Icon name="brush" size={96} class="text-brand/30" />
        </div>
      </div>

      <!-- Analytics & Google -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="md:order-2">
          <div class="w-14 h-14 bg-accent/10 rounded-2xl flex items-center justify-center mb-6">
            <Icon name="bar-chart-3" size={28} class="text-accent" />
          </div>
          <h2 class="text-3xl font-bold mb-4">Analytics &amp; Google-integratie</h2>
          <p class="text-gray-600 mb-4">
            Volg bezoekers, conversies en productprestaties. 
            Google Analytics wordt ondersteund in alle abonnementen, inclusief GA4, Tag Manager en Search Console.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Google Analytics 4 (GA4)</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Google Tag Manager</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Google Search Console</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Conversie-tracking en e-commerce events</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> GDPR-compliant cookie-instellingen</li>
          </ul>
        </div>
        <div class="bg-accent/10 rounded-2xl p-12 flex items-center justify-center md:order-1">
          <Icon name="trending-up" size={96} class="text-accent/30" />
        </div>
      </div>

      <!-- Open-source backend -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="w-14 h-14 bg-brand/10 rounded-2xl flex items-center justify-center mb-6">
            <Icon name="code-2" size={28} class="text-brand" />
          </div>
          <h2 class="text-3xl font-bold mb-4">Open-source backend</h2>
          <p class="text-gray-600 mb-4">
            Uniek in de markt: de ShopVirge backend is volledig open source. 
            Geen vendor lock-in. Je data en je code zijn altijd van jou. 
            En je hoeft zelf niks te hosten: wij regelen de infrastructuur.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Volledige broncode beschikbaar op GitHub</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Meerdere shops per installatie (multi-tenant)</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Veilige login via SSO</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Meertalige vertalingen ingebouwd per product en categorie</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Stripe-integratie voor betalingen</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> <a href="https://shopvirge.readthedocs.io" class="text-brand hover:underline" target="_blank">Volledige documentatie op ReadTheDocs</a></li>
          </ul>
        </div>
        <div class="bg-brand/5 rounded-2xl p-12 flex items-center justify-center">
          <Icon name="git-fork" size={96} class="text-brand/30" />
        </div>
      </div>

      <!-- Koppel je eigen shop of gebruik onze frontend -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="md:order-2">
          <div class="w-14 h-14 bg-accent/10 rounded-2xl flex items-center justify-center mb-6">
            <Icon name="plug" size={28} class="text-accent" />
          </div>
          <h2 class="text-3xl font-bold mb-4">Gebruik onze frontend, of bouw je eigen shop</h2>
          <p class="text-gray-600 mb-4">
            ShopVirge levert standaard een kant-en-klare webshop die je direct kunt gebruiken. 
            Maar je kunt ook je eigen frontend bouwen en via de API koppelen. 
            Ideaal als je al een website hebt of specifieke wensen hebt.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Kant-en-klare shopfrontend inbegrepen</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Of bouw je eigen app en koppel via de REST API</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Webhooks bij bestellingen en statuswijzigingen</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Afbeeldingen uploaden en beheren</li>
          </ul>
        </div>
        <div class="bg-accent/10 rounded-2xl p-12 flex items-center justify-center md:order-1">
          <Icon name="terminal" size={96} class="text-accent/30" />
        </div>
      </div>

      <!-- MCP Support -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="w-14 h-14 bg-brand/10 rounded-2xl flex items-center justify-center mb-6">
            <Icon name="cpu" size={28} class="text-brand" />
          </div>
          <h2 class="text-3xl font-bold mb-4">MCP-ready: AI-agents voor je productbeheer</h2>
          <p class="text-gray-600 mb-4">
            ShopVirge is een van de eerste e-commerce platforms met native MCP-ondersteuning (Model Context Protocol). 
            Alles wat je via de API kunt doen, kan nu ook door AI-agents worden aangestuurd. 
            Denk aan productbeschrijvingen genereren, vertalingen bijwerken, categorieën beheren en prijslijsten optimaliseren. 
            Allemaal vanuit tools zoals Claude, ChatGPT of je eigen agent-framework.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Producten aanmaken, bijwerken en vertalen via MCP</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Categorieën en tags beheren met AI-agents</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Prijslijsten en attributen automatisch optimaliseren</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Compatibel met Claude Desktop, Cursor, VS Code en meer</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Werkt met elk MCP-compatibel agent-framework</li>
          </ul>
        </div>
        <div class="bg-brand/5 rounded-2xl p-8 text-center">
          <div class="mb-4">
            <Icon name="cpu" size={64} class="text-brand/40 mx-auto" />
          </div>
          <div class="text-sm text-gray-500 font-mono space-y-1">
            <p class="bg-white/80 rounded px-3 py-1.5 text-left"><span class="text-brand">→</span> mcp: products.create</p>
            <p class="bg-white/80 rounded px-3 py-1.5 text-left"><span class="text-brand">→</span> mcp: translations.update</p>
            <p class="bg-white/80 rounded px-3 py-1.5 text-left"><span class="text-brand">→</span> mcp: categories.list</p>
            <p class="bg-white/80 rounded px-3 py-1.5 text-left"><span class="text-brand">→</span> mcp: prices.optimize</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="section-alt py-20">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Klaar om te beginnen?</h2>
      <p class="text-gray-600 mb-8">Start vandaag nog met je meertalige webshop of portfolio.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`${base}nl/contact/?type=trial`} class="btn-primary">Start gratis trial →</a>
        <a href={`${base}nl/prijzen/`} class="btn-secondary">Bekijk prijzen</a>
      </div>
    </div>
  </section>
</Layout>
