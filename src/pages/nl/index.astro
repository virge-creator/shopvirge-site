---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="ShopVirge — Meertalige webshops & portfolios" lang="nl">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <!-- Hero image -->
    <div class="relative w-full h-[500px] md:h-[600px] lg:h-[700px]">
      <img 
        src={`${base}images/hero-home.jpg`}
        alt="ShopVirge — Vertaal je webshop automatisch naar elke taal"
        class="w-full h-full object-cover"
      />
      <!-- Gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-r from-brand-dark/90 via-brand/70 to-transparent"></div>
      <!-- Content overlay -->
      <div class="absolute inset-0 flex items-center">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
          <div class="max-w-2xl">
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 leading-tight text-white drop-shadow-lg">
              Je webshop, <span class="text-amber-400">in elke taal</span>, in enkele minuten.
            </h1>
            <p class="text-lg md:text-xl text-white/90 mb-8 drop-shadow">
              ShopVirge is het open-source webshopplatform met een headless backend. 
              Beschrijf je producten één keer, en wij vertalen en publiceren automatisch in elke taal.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href={`${base}nl/contact/?type=trial`} class="btn-primary bg-white text-brand hover:bg-gray-100 shadow-lg">
                Start gratis →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features teaser -->
  <section class="py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Alles wat je nodig hebt om te groeien
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Een open-source headless backend, automatische vertalingen, Stripe-betalingen en een REST API die je volledige vrijheid geeft.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="card">
          <div class="w-12 h-12 bg-brand/10 rounded-xl flex items-center justify-center mb-4">
            <Icon name="globe" size={24} class="text-brand" />
          </div>
          <h3 class="text-xl font-bold mb-2">Automatisch meertalig</h3>
          <p class="text-gray-600">Jouw hele site wordt automatisch vertaald. Kies zelf welke talen.</p>
        </div>
        <div class="card">
          <div class="w-12 h-12 bg-brand/10 rounded-xl flex items-center justify-center mb-4">
            <Icon name="zap" size={24} class="text-brand" />
          </div>
          <h3 class="text-xl font-bold mb-2">Snel live, zonder gedoe</h3>
          <p class="text-gray-600">Upload producten handmatig of importeer vanuit Excel. Van concept tot live site in minder dan een uur.</p>
        </div>
        <div class="card">
          <div class="w-12 h-12 bg-brand/10 rounded-xl flex items-center justify-center mb-4">
            <Icon name="credit-card" size={24} class="text-brand" />
          </div>
          <h3 class="text-xl font-bold mb-2">Betalingen via Stripe</h3>
          <p class="text-gray-600">iDEAL, PayPal, creditcard. Stripe is volledig geïntegreerd, inclusief webhook-notificaties bij elke bestelling.</p>
        </div>
        <div class="card">
          <div class="w-12 h-12 bg-brand/10 rounded-xl flex items-center justify-center mb-4">
            <Icon name="smartphone" size={24} class="text-brand" />
          </div>
          <h3 class="text-xl font-bold mb-2">Mobiel-first design</h3>
          <p class="text-gray-600">Perfect op telefoon, tablet en desktop. Geoptimaliseerd voor conversie.</p>
        </div>
        <div class="card">
          <div class="w-12 h-12 bg-brand/10 rounded-xl flex items-center justify-center mb-4">
            <Icon name="cpu" size={24} class="text-brand" />
          </div>
          <h3 class="text-xl font-bold mb-2">MCP-ready voor AI-agents</h3>
          <p class="text-gray-600">Beheer producten, categorieën en vertalingen via MCP. Laat AI-agents je PIM aansturen.</p>
        </div>
        <div class="card">
          <div class="w-12 h-12 bg-brand/10 rounded-xl flex items-center justify-center mb-4">
            <Icon name="code-2" size={24} class="text-brand" />
          </div>
          <h3 class="text-xl font-bold mb-2">Open-source backend</h3>
          <p class="text-gray-600">Onze headless FastAPI-backend is volledig open source. Geen vendor lock-in, volledige controle via de REST API.</p>
        </div>
      </div>

      <div class="text-center mt-12">
        <a href={`${base}nl/functies/`} class="btn-primary">Bekijk alle functies →</a>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section-alt py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Hoe het werkt</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-brand text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">1</div>
          <h3 class="text-xl font-bold mb-2">Vertel wat je verkoopt</h3>
          <p class="text-gray-600">Beschrijf je producten of diensten. Upload foto's. Geef de basis mee.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-brand text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">2</div>
          <h3 class="text-xl font-bold mb-2">Wij vertalen alles</h3>
          <p class="text-gray-600">Kies je talen en ShopVirge vertaalt je hele site automatisch.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-brand text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">3</div>
          <h3 class="text-xl font-bold mb-2">Ga live</h3>
          <p class="text-gray-600">Publish met één klik. Vanaf dat moment draait je meertalige shop.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing teaser -->
  <section class="py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Eenvoudige prijzen</h2>
        <p class="text-lg text-gray-600">Geen verrassingen. Betaal voor wat je gebruikt.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <div class="card text-center">
          <h3 class="text-xl font-bold mb-1">Small</h3>
          <p class="text-3xl font-extrabold my-3">€50<span class="text-base font-normal text-gray-500">/mnd</span></p>
          <p class="text-sm text-gray-500 mb-4">1 taal · max 100 producten</p>
          <a href={`${base}nl/prijzen/`} class="btn-secondary w-full text-center block">Meer info →</a>
        </div>
        <div class="card border-2 border-brand text-center relative">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 inline-block px-3 py-1 bg-brand text-white text-xs font-semibold rounded-full">Meest gekozen</span>
          <h3 class="text-xl font-bold mb-1 mt-2">Medium</h3>
          <p class="text-3xl font-extrabold my-3">€75<span class="text-base font-normal text-gray-500">/mnd</span></p>
          <p class="text-sm text-gray-500 mb-4">3 talen · max 300 producten · Excel import</p>
          <a href={`${base}nl/prijzen/`} class="btn-primary w-full text-center block">Meer info →</a>
        </div>
        <div class="card text-center">
          <h3 class="text-xl font-bold mb-1">Large</h3>
          <p class="text-3xl font-extrabold my-3">€100<span class="text-base font-normal text-gray-500">/mnd</span></p>
          <p class="text-sm text-gray-500 mb-4">3 talen · onbeperkt · full-service</p>
          <a href={`${base}nl/prijzen/`} class="btn-secondary w-full text-center block">Meer info →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-alt py-20">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Klaar om te starten?</h2>
      <p class="text-gray-600 mb-8">Neem contact op en we helpen je binnen 24 uur verder.</p>
      <a href={`${base}nl/contact/`} class="btn-primary">Neem contact op →</a>
    </div>
  </section>
</Layout>
