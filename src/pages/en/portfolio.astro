---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Product-portfolio - ShopVirge" description="Show your work to the world with a professional product-portfolio from ShopVirge." lang="en">
  <section class="hero text-white py-24 md:py-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 px-3 py-1 bg-white/20 rounded-full text-sm mb-4">
          <Icon name="sparkles" size={16} class="text-white" /> Feature
        </span>
        <h1 class="text-4xl md:text-5xl font-extrabold mb-6 leading-tight">
          Your work, <span class="text-accent">perfectly presented</span>
        </h1>
        <p class="text-xl text-white/80 mb-8">
          A product-portfolio is more than a website.
          It's your business card, your story, your first impression.
          ShopVirge helps you stand out.
        </p>
        <a href={`${base}en/contact/`} class="btn-primary bg-white text-brand hover:bg-gray-100">
          View options →
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Webshop or Product-portfolio?</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">Choose the form that fits what you want to achieve.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <div class="card border-2 border-brand">
          <div class="w-12 h-12 bg-brand/10 rounded-xl flex items-center justify-center mb-4">
            <Icon name="shopping-cart" size={24} class="text-brand" />
          </div>
          <h3 class="text-2xl font-bold mb-3">Webshop</h3>
          <p class="text-gray-600 mb-6">
            Perfect if you want to sell products directly online.
            With built-in payment options, customers can browse,
            add to cart and check out, all in one smooth experience.
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li>✓ Direct sales</li>
            <li>✓ iDEAL, PayPal, credit card</li>
            <li>✓ Inventory management</li>
            <li>✓ Order tracking</li>
          </ul>
        </div>
        <div class="card">
          <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center mb-4">
            <Icon name="palette" size={24} class="text-accent" />
          </div>
          <h3 class="text-2xl font-bold mb-3">Product-portfolio</h3>
          <p class="text-gray-600 mb-6">
            Ideal for showcasing your work or products without direct sales.
            Present your creations beautifully, attract interest
            and build credibility with potential clients or collaborators.
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li>✓ Beautiful presentation</li>
            <li>✓ Contact form</li>
            <li>✓ Project categories</li>
            <li>✓ SEO optimized</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section-alt py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 mb-12 text-center">Examples of what you can showcase</h2>
      <div class="grid md:grid-cols-4 gap-6">
        <div class="bg-white rounded-xl p-6 text-center shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 bg-brand/10 rounded-xl flex items-center justify-center mx-auto mb-3">
            <Icon name="camera" size={20} class="text-brand" />
          </div>
          <p class="font-medium text-sm">Photography</p>
        </div>
        <div class="bg-white rounded-xl p-6 text-center shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 bg-brand/10 rounded-xl flex items-center justify-center mx-auto mb-3">
            <Icon name="video" size={20} class="text-brand" />
          </div>
          <p class="font-medium text-sm">Video & Film</p>
        </div>
        <div class="bg-white rounded-xl p-6 text-center shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 bg-brand/10 rounded-xl flex items-center justify-center mx-auto mb-3">
            <Icon name="pen-tool" size={20} class="text-brand" />
          </div>
          <p class="font-medium text-sm">Graphic Design</p>
        </div>
        <div class="bg-white rounded-xl p-6 text-center shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 bg-brand/10 rounded-xl flex items-center justify-center mx-auto mb-3">
            <Icon name="building-2" size={20} class="text-brand" />
          </div>
          <p class="font-medium text-sm">Architecture</p>
        </div>
        <div class="bg-white rounded-xl p-6 text-center shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 bg-brand/10 rounded-xl flex items-center justify-center mx-auto mb-3">
            <Icon name="code-2" size={20} class="text-brand" />
          </div>
          <p class="font-medium text-sm">Development</p>
        </div>
        <div class="bg-white rounded-xl p-6 text-center shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 bg-brand/10 rounded-xl flex items-center justify-center mx-auto mb-3">
            <Icon name="shirt" size={20} class="text-brand" />
          </div>
          <p class="font-medium text-sm">Fashion</p>
        </div>
        <div class="bg-white rounded-xl p-6 text-center shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 bg-brand/10 rounded-xl flex items-center justify-center mx-auto mb-3">
            <Icon name="heart-pulse" size={20} class="text-brand" />
          </div>
          <p class="font-medium text-sm">Fitness & Wellness</p>
        </div>
        <div class="bg-white rounded-xl p-6 text-center shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 bg-brand/10 rounded-xl flex items-center justify-center mx-auto mb-3">
            <Icon name="chef-hat" size={20} class="text-brand" />
          </div>
          <p class="font-medium text-sm">Catering & Recipes</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">Ready to show your work?</h2>
      <p class="text-lg text-gray-600 mb-8">Request a no-obligation quote and we'll help you out within 24 hours.</p>
      <a href={`${base}en/contact/`} class="btn-primary">Get in touch →</a>
    </div>
  </section>
</Layout>
