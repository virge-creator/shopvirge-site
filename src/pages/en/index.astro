---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="ShopVirge - Multilingual webshops & product-portfolios" description="ShopVirge — your multilingual webshop in minutes. Automatic translations, Stripe payments and mobile-first design. From €50/month." lang="en">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <!-- Hero image -->
    <div class="relative w-full h-[500px] md:h-[600px] lg:h-[700px]">
      <img 
        src={`${base}images/hero-home.jpg`}
        alt="ShopVirge - Automatically translate your webshop to any language"
        class="w-full h-full object-cover"
      />
      <!-- Gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-r from-brand-dark/90 via-brand/70 to-transparent"></div>
      <!-- Content overlay -->
      <div class="absolute inset-0 flex items-center">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
          <div class="max-w-2xl">
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 leading-tight text-white drop-shadow-lg">
              Your webshop, <span class="text-amber-400">in any language</span>, in minutes.
            </h1>
            <p class="text-lg md:text-xl text-white/90 mb-8 drop-shadow">
              ShopVirge is the open-source webshop platform with a headless backend. 
              Describe your products once, and we'll translate and publish them in any language automatically.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href={`${base}en/contact/?type=trial`} class="btn-primary bg-white text-brand hover:bg-gray-100 shadow-lg">
                Start free →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features teaser -->
  <section class="py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Everything you need to grow</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">An open-source headless backend, automatic translations, Stripe payments, and a REST API that gives you full freedom.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="card">
          <div class="w-12 h-12 bg-brand/10 rounded-xl flex items-center justify-center mb-4">
            <Icon name="globe" size={24} class="text-brand" />
          </div>
          <h3 class="text-xl font-bold mb-2">Automatic multilingual</h3>
          <p class="text-gray-600">Your entire site gets translated automatically. You choose which languages.</p>
        </div>
        <div class="card">
          <div class="w-12 h-12 bg-brand/10 rounded-xl flex items-center justify-center mb-4">
            <Icon name="zap" size={24} class="text-brand" />
          </div>
          <h3 class="text-xl font-bold mb-2">Go live fast, no hassle</h3>
          <p class="text-gray-600">Upload products manually or import from Excel. From concept to live site in under an hour.</p>
        </div>
        <div class="card">
          <div class="w-12 h-12 bg-brand/10 rounded-xl flex items-center justify-center mb-4">
            <Icon name="credit-card" size={24} class="text-brand" />
          </div>
          <h3 class="text-xl font-bold mb-2">Payments via Stripe</h3>
          <p class="text-gray-600">iDEAL, PayPal, credit card. Stripe is fully integrated, with webhook notifications on every order.</p>
        </div>
        <div class="card">
          <div class="w-12 h-12 bg-brand/10 rounded-xl flex items-center justify-center mb-4">
            <Icon name="smartphone" size={24} class="text-brand" />
          </div>
          <h3 class="text-xl font-bold mb-2">Mobile-first design</h3>
          <p class="text-gray-600">Perfect on phone, tablet and desktop. Optimized for conversion.</p>
        </div>
        <div class="card">
          <div class="w-12 h-12 bg-brand/10 rounded-xl flex items-center justify-center mb-4">
            <Icon name="cpu" size={24} class="text-brand" />
          </div>
          <h3 class="text-xl font-bold mb-2">MCP-ready for AI agents</h3>
          <p class="text-gray-600">Manage products, categories and translations via MCP. Let AI agents drive your PIM.</p>
        </div>
        <div class="card">
          <div class="w-12 h-12 bg-brand/10 rounded-xl flex items-center justify-center mb-4">
            <Icon name="code-2" size={24} class="text-brand" />
          </div>
          <h3 class="text-xl font-bold mb-2">Open-source backend</h3>
          <p class="text-gray-600">Our headless FastAPI backend is fully open source. No vendor lock-in, full control via the REST API.</p>
        </div>
      </div>

      <div class="text-center mt-12">
        <a href={`${base}en/features/`} class="btn-primary">View all features →</a>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section-alt py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">How it works</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-brand text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">1</div>
          <h3 class="text-xl font-bold mb-2">Tell us what you sell</h3>
          <p class="text-gray-600">Describe your products or services. Upload photos. Give us the basics.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-brand text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">2</div>
          <h3 class="text-xl font-bold mb-2">We translate everything</h3>
          <p class="text-gray-600">Choose your languages and ShopVirge automatically translates your entire site.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-brand text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">3</div>
          <h3 class="text-xl font-bold mb-2">Go live</h3>
          <p class="text-gray-600">Publish with one click. From that moment on, your multilingual shop runs.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing teaser -->
  <section class="py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Simple pricing</h2>
        <p class="text-lg text-gray-600">No surprises. Pay for what you use.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <div class="card text-center">
          <h3 class="text-xl font-bold mb-1">Small</h3>
          <p class="text-3xl font-extrabold mt-3 mb-1">€50<span class="text-base font-normal text-gray-500">/mo</span></p>
          <p class="text-xs text-gray-400 mb-3">No onboarding fee</p>
          <p class="text-sm text-gray-500 mb-4">1 language · max 100 products</p>
          <a href={`${base}en/pricing/`} class="btn-secondary w-full text-center block">More info →</a>
        </div>
        <div class="card border-2 border-brand text-center relative">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 inline-block px-3 py-1 bg-brand text-white text-xs font-semibold rounded-full">Most popular</span>
          <h3 class="text-xl font-bold mb-1 mt-2">Medium</h3>
          <p class="text-3xl font-extrabold mt-3 mb-1">€75<span class="text-base font-normal text-gray-500">/mo</span></p>
          <p class="text-xs text-gray-400 mb-3">+ €1,000 one-time onboarding</p>
          <p class="text-sm text-gray-500 mb-4">3 languages · max 300 products · Excel import</p>
          <a href={`${base}en/pricing/`} class="btn-primary w-full text-center block">More info →</a>
        </div>
        <div class="card text-center">
          <h3 class="text-xl font-bold mb-1">Large</h3>
          <p class="text-3xl font-extrabold mt-3 mb-1">€100<span class="text-base font-normal text-gray-500">/mo</span></p>
          <p class="text-xs text-gray-400 mb-3">Onboarding on request</p>
          <p class="text-sm text-gray-500 mb-4">3 languages · unlimited products · full-service</p>
          <a href={`${base}en/pricing/`} class="btn-secondary w-full text-center block">More info →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-alt py-20">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to get started?</h2>
      <p class="text-gray-600 mb-8">Get in touch and we'll help you within 24 hours.</p>
      <a href={`${base}en/contact/`} class="btn-primary">Contact us →</a>
    </div>
  </section>
</Layout>
