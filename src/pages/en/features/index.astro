---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Features - Everything you need" description="Discover all ShopVirge features: automatic translations, Stripe payments, MCP-ready API, mobile-first design and an open-source backend." lang="en">
  <section class="hero text-white py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-extrabold mb-6">Features — Everything you need for a multilingual webshop</h1>
        <p class="text-xl text-white/80">
          Discover all the tools to launch a professional, multilingual webshop or portfolio.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-24">

      <!-- Multilingual -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="w-14 h-14 bg-brand/10 rounded-2xl flex items-center justify-center mb-6">
            <Icon name="globe" size={28} class="text-brand" />
          </div>
          <h2 class="text-3xl font-bold mb-4">Automatic multilingual</h2>
          <p class="text-gray-600 mb-4">
            Translation has never been easier. Your entire site gets translated automatically 
            in the languages you choose: products, categories, pages and metadata.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Dutch, English, German, French, Spanish and more</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> SEO and GEO-optimized translations per language</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Manual adjustments always possible</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Automatic language detection for visitors</li>
          </ul>
        </div>
        <div class="bg-brand/5 rounded-2xl p-12 flex items-center justify-center">
          <Icon name="languages" size={96} class="text-brand/30" />
        </div>
      </div>

      <!-- Quick launch -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="md:order-2">
          <div class="w-14 h-14 bg-accent/10 rounded-2xl flex items-center justify-center mb-6">
            <Icon name="zap" size={28} class="text-accent" />
          </div>
          <h2 class="text-3xl font-bold mb-4">Go live fast, no hassle</h2>
          <p class="text-gray-600 mb-4">
            From concept to fully live site in less than an hour. 
            Upload your products manually, or import them directly from an Excel file.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Step-by-step guidance</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Product import from Excel or CSV</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Drag-and-drop image uploads</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Automatic sitemap, SEO and GEO tags</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Publish with one click</li>
          </ul>
        </div>
        <div class="bg-accent/10 rounded-2xl p-12 flex items-center justify-center md:order-1">
          <Icon name="rocket" size={96} class="text-accent/30" />
        </div>
      </div>

      <!-- Payments via Stripe -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="w-14 h-14 bg-brand/10 rounded-2xl flex items-center justify-center mb-6">
            <Icon name="credit-card" size={28} class="text-brand" />
          </div>
          <h2 class="text-3xl font-bold mb-4">Payments via Stripe</h2>
          <p class="text-gray-600 mb-4">
            Stripe is fully integrated. Accept all major payment methods 
            without extra plugins or custom work. We help you set up Stripe.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> iDEAL and Bancontact</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Credit card (Visa, Mastercard, Amex)</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> PayPal</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Automatic invoices and receipts</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Webhook notifications on every order</li>
          </ul>
        </div>
        <div class="bg-brand/5 rounded-2xl p-12 flex items-center justify-center">
          <Icon name="wallet" size={96} class="text-brand/30" />
        </div>
      </div>

      <!-- Mobile -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="md:order-2">
          <div class="w-14 h-14 bg-accent/10 rounded-2xl flex items-center justify-center mb-6">
            <Icon name="smartphone" size={28} class="text-accent" />
          </div>
          <h2 class="text-3xl font-bold mb-4">Mobile-first design</h2>
          <p class="text-gray-600 mb-4">
            Every site looks perfect on phone, tablet and desktop. 
            Optimized for speed and conversion.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Responsive on every screen size</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Super fast (&lt; 1s load time)</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Touch-optimized navigation</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Works offline as an app on your phone</li>
          </ul>
        </div>
        <div class="bg-accent/10 rounded-2xl p-12 flex items-center justify-center md:order-1">
          <Icon name="tablet-smartphone" size={96} class="text-accent/30" />
        </div>
      </div>

      <!-- Design -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="w-14 h-14 bg-brand/10 rounded-2xl flex items-center justify-center mb-6">
            <Icon name="palette" size={28} class="text-brand" />
          </div>
          <h2 class="text-3xl font-bold mb-4">No design skills needed</h2>
          <p class="text-gray-600 mb-4">
            Professional-looking websites out of the box. 
            Choose from ready-made templates and customize with your own brand colors.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> 20+ professional templates</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Custom colors, fonts and logo</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Custom CSS supported</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Dark mode support</li>
          </ul>
        </div>
        <div class="bg-brand/5 rounded-2xl p-12 flex items-center justify-center">
          <Icon name="brush" size={96} class="text-brand/30" />
        </div>
      </div>

      <!-- Analytics & Google -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="md:order-2">
          <div class="w-14 h-14 bg-accent/10 rounded-2xl flex items-center justify-center mb-6">
            <Icon name="bar-chart-3" size={28} class="text-accent" />
          </div>
          <h2 class="text-3xl font-bold mb-4">Analytics &amp; Google integration</h2>
          <p class="text-gray-600 mb-4">
            Track visitors, conversions and product performance. 
            Google Analytics is supported in all plans, including GA4, Tag Manager and Search Console.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Google Analytics 4 (GA4)</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Google Tag Manager</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Google Search Console</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Conversion tracking and e-commerce events</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> GDPR-compliant cookie settings</li>
          </ul>
        </div>
        <div class="bg-accent/10 rounded-2xl p-12 flex items-center justify-center md:order-1">
          <Icon name="trending-up" size={96} class="text-accent/30" />
        </div>
      </div>

      <!-- Open-source backend -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="w-14 h-14 bg-brand/10 rounded-2xl flex items-center justify-center mb-6">
            <Icon name="code-2" size={28} class="text-brand" />
          </div>
          <h2 class="text-3xl font-bold mb-4">Open-source backend</h2>
          <p class="text-gray-600 mb-4">
            Unique in the market: the ShopVirge backend is fully open source. 
            No vendor lock-in. Your data and code are always yours. 
            And you don't need to host anything yourself: we handle the infrastructure.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Full source code available on GitHub</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Multiple shops per installation (multi-tenant)</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Secure login via SSO</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Built-in multilingual translations per product and category</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Stripe integration for payments</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> <a href="https://shopvirge.readthedocs.io" class="text-brand hover:underline" target="_blank">Full documentation on ReadTheDocs</a></li>
          </ul>
        </div>
        <div class="bg-brand/5 rounded-2xl p-12 flex items-center justify-center">
          <Icon name="git-fork" size={96} class="text-brand/30" />
        </div>
      </div>

      <!-- Use our frontend or build your own -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="md:order-2">
          <div class="w-14 h-14 bg-accent/10 rounded-2xl flex items-center justify-center mb-6">
            <Icon name="plug" size={28} class="text-accent" />
          </div>
          <h2 class="text-3xl font-bold mb-4">Use our frontend, or build your own shop</h2>
          <p class="text-gray-600 mb-4">
            ShopVirge comes with a ready-to-use shop frontend out of the box. 
            But you can also build your own frontend and connect it via the API. 
            Ideal if you already have a website or have specific requirements.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Ready-to-use shop frontend included</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Or build your own app and connect via the REST API</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Webhooks on orders and status changes</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Image uploads and management</li>
          </ul>
        </div>
        <div class="bg-accent/10 rounded-2xl p-12 flex items-center justify-center md:order-1">
          <Icon name="terminal" size={96} class="text-accent/30" />
        </div>
      </div>

      <!-- MCP Support -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="w-14 h-14 bg-brand/10 rounded-2xl flex items-center justify-center mb-6">
            <Icon name="cpu" size={28} class="text-brand" />
          </div>
          <h2 class="text-3xl font-bold mb-4">MCP-ready: AI agents for your product management</h2>
          <p class="text-gray-600 mb-4">
            ShopVirge is one of the first e-commerce platforms with native MCP support (Model Context Protocol). 
            Everything you can do via the API can now be driven by AI agents. 
            Generate product descriptions, update translations, manage categories and optimize price lists. 
            All from tools like Claude, ChatGPT or your own agent framework.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Create, update and translate products via MCP</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Manage categories and tags with AI agents</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Automatically optimize price lists and attributes</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Compatible with Claude Desktop, Cursor, VS Code and more</li>
            <li class="flex items-center gap-2"><span class="text-brand">✓</span> Works with any MCP-compatible agent framework</li>
          </ul>
        </div>
        <div class="bg-brand/5 rounded-2xl p-8 text-center">
          <div class="mb-4">
            <Icon name="cpu" size={64} class="text-brand/40 mx-auto" />
          </div>
          <div class="text-sm text-gray-500 font-mono space-y-1">
            <p class="bg-white/80 rounded px-3 py-1.5 text-left"><span class="text-brand">→</span> mcp: products.create</p>
            <p class="bg-white/80 rounded px-3 py-1.5 text-left"><span class="text-brand">→</span> mcp: translations.update</p>
            <p class="bg-white/80 rounded px-3 py-1.5 text-left"><span class="text-brand">→</span> mcp: categories.list</p>
            <p class="bg-white/80 rounded px-3 py-1.5 text-left"><span class="text-brand">→</span> mcp: prices.optimize</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="section-alt py-20">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to get started?</h2>
      <p class="text-gray-600 mb-8">Launch your multilingual webshop or portfolio today.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`${base}en/contact/?type=trial`} class="btn-primary">Start free trial →</a>
        <a href={`${base}en/pricing/`} class="btn-secondary">View pricing</a>
      </div>
    </div>
  </section>
</Layout>
