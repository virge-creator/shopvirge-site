---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
const base = import.meta.env.BASE_URL;

// Webinars are held the second Wednesday of every month, in the afternoon.
// Dates are computed at build time so the list never goes stale.
function secondWednesday(year: number, month: number): Date {
  const d = new Date(year, month, 1);
  const offset = (3 - d.getDay() + 7) % 7; // 3 = Wednesday → first Wednesday
  d.setDate(1 + offset + 7); // + one week → second Wednesday
  return d;
}

const today = new Date();
today.setHours(0, 0, 0, 0);
const upcoming: Date[] = [];
let y = today.getFullYear();
let m = today.getMonth();
while (upcoming.length < 4) {
  const sw = secondWednesday(y, m);
  if (sw >= today) upcoming.push(sw);
  m++;
  if (m > 11) { m = 0; y++; }
}

const dateFmt = new Intl.DateTimeFormat('en-GB', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
});
const monthFmt = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' });
const shortMonthFmt = new Intl.DateTimeFormat('en-GB', { month: 'short' });
const time = '3:00 – 4:00 PM (CET)';
const webinarOptions = upcoming.map((d) => dateFmt.format(d));
const weekdays = ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'];

// Build a Monday-first month grid; null cells pad the leading/trailing gaps.
function monthGrid(year: number, month: number): (number | null)[] {
  const startDow = (new Date(year, month, 1).getDay() + 6) % 7; // Monday = 0
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  const cells: (number | null)[] = Array(startDow).fill(null);
  for (let d = 1; d <= daysInMonth; d++) cells.push(d);
  while (cells.length % 7 !== 0) cells.push(null);
  return cells;
}
const calendars = upcoming.map((d) => ({
  label: monthFmt.format(d),
  cells: monthGrid(d.getFullYear(), d.getMonth()),
  highlight: d.getDate(),
}));
---
<Layout
  title="Webinars - Get to know ShopVirge"
  description="Free monthly ShopVirge webinars. Every second Wednesday of the month in the afternoon: live demo, practical tips and your questions answered. Sign up for free."
  lang="en">
  <section class="hero text-white py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-1.5 text-sm font-medium mb-6">
          <Icon name="video" size={16} class="text-white" /> Free · Online · Monthly
        </span>
        <h1 class="text-4xl md:text-5xl font-extrabold mb-6">Webinars</h1>
        <p class="text-xl text-white/80">
          Every second Wednesday of the month, in the afternoon, we show you live how to build and
          grow a multilingual webshop with ShopVirge. Free, online and with plenty of room for
          your questions.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-start">
        <!-- Left: info + schedule -->
        <div>
          <h2 class="text-3xl font-extrabold mb-4">What to expect</h2>
          <p class="text-gray-600 mb-8">
            Our webinars run for about 45 minutes: a live demo of the platform, practical tips from
            real webshops and then all the time you need for your questions. You need nothing but a
            browser. We'll email you the join link after you sign up.
          </p>

          <div class="grid sm:grid-cols-2 gap-4 mb-12">
            <div class="bg-brand/5 border border-brand/20 rounded-xl p-5">
              <h3 class="font-bold text-brand mb-1 flex items-center gap-2">
                <Icon name="calendar-days" size={18} class="text-brand" /> When
              </h3>
              <p class="text-sm text-gray-600">Second Wednesday of the month, {time}.</p>
            </div>
            <div class="bg-brand/5 border border-brand/20 rounded-xl p-5">
              <h3 class="font-bold text-brand mb-1 flex items-center gap-2">
                <Icon name="monitor-play" size={18} class="text-brand" /> Live demo
              </h3>
              <p class="text-sm text-gray-600">See the platform in action — no sales pitch.</p>
            </div>
            <div class="bg-brand/5 border border-brand/20 rounded-xl p-5">
              <h3 class="font-bold text-brand mb-1 flex items-center gap-2">
                <Icon name="messages-square" size={18} class="text-brand" /> Q&amp;A
              </h3>
              <p class="text-sm text-gray-600">Ask your questions directly to our team.</p>
            </div>
            <div class="bg-brand/5 border border-brand/20 rounded-xl p-5">
              <h3 class="font-bold text-brand mb-1 flex items-center gap-2">
                <Icon name="gift" size={18} class="text-brand" /> Free
              </h3>
              <p class="text-sm text-gray-600">No cost, no obligations.</p>
            </div>
          </div>

          <h2 class="text-2xl font-extrabold mb-6">Upcoming webinars</h2>
          <ul class="space-y-4">
            {upcoming.map((d) => (
              <li class="flex gap-4 items-start border border-gray-200 rounded-xl p-5 hover:border-brand/40 transition-colors">
                <div class="shrink-0 text-center bg-brand/5 rounded-lg px-3 py-2 w-16">
                  <span class="block text-2xl font-extrabold text-brand leading-none">{d.getDate()}</span>
                  <span class="block text-xs uppercase tracking-wide text-gray-500 mt-1">{shortMonthFmt.format(d)}</span>
                </div>
                <div>
                  <p class="font-semibold text-text-heading">ShopVirge live webinar &amp; demo</p>
                  <p class="text-sm text-gray-500 mt-1">{dateFmt.format(d)} · {time}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Right: signup form -->
        <div class="lg:sticky lg:top-24">
          <div class="card p-6 md:p-8">
            <h2 class="text-2xl font-extrabold mb-2">Sign up</h2>
            <p class="text-gray-600 mb-6 text-sm">
              Pick a date and register for free. We'll email you the join link.
            </p>
            <form action="https://formspree.io/f/mkokrkdl" method="POST" class="space-y-4">
              <input type="hidden" name="_subject" value="Webinar signup - ShopVirge" />
              <input type="hidden" name="type" value="webinar" />
              <input type="hidden" name="source" value="webinars-page" />

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Name *</label>
                  <input type="text" name="name" required
                    class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Company</label>
                  <input type="text" name="company"
                    class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none" />
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
                <input type="email" name="email" required
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Which date? *</label>
                <select name="webinar" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none bg-white">
                  {webinarOptions.map((opt) => <option value={opt}>{opt}</option>)}
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Question in advance (optional)</label>
                <textarea name="message" rows="3"
                  placeholder="Anything specific you'd like us to cover?"
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none resize-none"></textarea>
              </div>
              <button type="submit" class="btn-primary w-full">Sign me up →</button>
              <p class="text-xs text-gray-400 text-center">
                Prefer a personal demo? <a href={`${base}en/contact/?type=demo`} class="text-brand hover:underline">Request a demo</a>.
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Calendar -->
  <section class="pb-20 md:pb-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-extrabold mb-6">Calendar</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {calendars.map((cal) => (
          <div class="border border-gray-200 rounded-xl p-5">
            <p class="font-bold text-text-heading text-center mb-4">{cal.label}</p>
            <div class="grid grid-cols-7 gap-1 text-center text-xs">
              {weekdays.map((wd) => <span class="text-gray-400 font-medium py-1">{wd}</span>)}
              {cal.cells.map((day) => (
                day === null
                  ? <span></span>
                  : day === cal.highlight
                    ? <span class="flex items-center justify-center aspect-square rounded-full bg-brand text-white font-bold">{day}</span>
                    : <span class="flex items-center justify-center aspect-square text-gray-600">{day}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
      <p class="text-sm text-gray-500 mt-4 flex items-center gap-2">
        <span class="inline-block w-3 h-3 rounded-full bg-brand"></span>
        Webinar date · second Wednesday of the month, {time}
      </p>
    </div>
  </section>
</Layout>
