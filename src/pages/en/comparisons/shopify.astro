---
import Layout from '../../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
const siteUrl = 'https://shopvirge.com';

// Three pain points from the Shopify deep dive (June 2026)
const painPoints = [
  {
    n: 1,
    title: 'Scripts deprecation deadline (June 30, 2026)',
    severity: 'Critical',
    sevClass: 'bg-danger/10 text-danger',
    problem: 'Shopify is killing Scripts on June 30, 2026. Merchants face $15K–$50K migration costs to Shopify Functions. Complex discount logic breaks, with no 1:1 parity. Thousands of stores scrambling.',
    evidence: '$15K–$50K migration quotes; merchants reporting 60% functionality loss in Functions vs Scripts.',
    opp: 'Zero migration cost: ShopVirge discount logic is built-in and won\'t be deprecated by a platform decision.',
  },
  {
    n: 2,
    title: 'Non-Plus checkout auto-upgrade (Aug 26)',
    severity: 'Critical',
    sevClass: 'bg-danger/10 text-danger',
    problem: 'Shopify is force-upgrading all non-Plus stores to the new checkout extensibility on August 26. Custom checkout scripts, post-purchase upsells and tracking pixels will break silently.',
    evidence: 'Merchants discovering broken post-purchase flows and lost conversion tracking.',
    opp: 'Full checkout control with an open-source backend, no forced migrations.',
  },
  {
    n: 3,
    title: 'Platform outage (June 3, 2hr global)',
    severity: 'High',
    sevClass: 'bg-warning/20 text-yellow-700',
    problem: 'Shopify went down globally for 2 hours on June 3. Merchants lost sales with zero recourse. No SLA, no credits, no transparency.',
    evidence: '2-hour global outage; merchants reporting $10K+ in lost sales.',
    opp: 'A self-hosted option means you control uptime. Multi-cloud deployment is possible.',
  },
];

// Two forced deadlines (timeline)
const deadlines = [
  { date: 'June 30, 2026', label: 'Scripts disabled', sub: '$15K–$50K migration · 60% functionality loss', color: 'bg-danger' },
  { date: 'Aug 26, 2026', label: 'Checkout auto-upgrade (non-Plus)', sub: 'Custom scripts & pixels break silently', color: 'bg-danger' },
];

// App-stacking: advertised plan vs real monthly cost
const stackMax = 300;
const appStack = [
  { name: 'Advertised base plan', value: 29, label: '$29', color: 'bg-success' },
  { name: 'Reality with essential apps', value: 300, label: '$300+', color: 'bg-danger' },
];

// Plus tier vs ShopVirge (monthly)
const plusMax = 2300;
const plusCmp = [
  { name: 'Shopify Plus', value: 2300, label: '$2,300+/mo', color: 'bg-danger' },
  { name: 'ShopVirge Large', value: 100, label: '€100/mo', color: 'bg-success' },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "Shopify vs ShopVirge: the complete deep dive",
  "description": "An in-depth analysis of Shopify's pain points: Scripts deprecation (June 30, 2026, $15K–$50K, 60% functionality loss), forced checkout upgrade (Aug 26) and the 2-hour outage, plus app-stacking and lock-in.",
  "datePublished": "2026-06-08",
  "author": { "@type": "Organization", "name": "ShopVirge Market Intelligence" },
  "publisher": { "@type": "Organization", "name": "ShopVirge", "logo": { "@type": "ImageObject", "url": `${siteUrl}${base}images/logo.png` } },
  "inLanguage": "en",
  "url": `${siteUrl}${base}en/comparisons/shopify/`,
};
---
<Layout
  title="Shopify vs ShopVirge: the complete deep dive"
  description="An in-depth analysis of Shopify's pain points: Scripts deprecation (June 30, 2026, $15K–$50K), forced checkout upgrade (Aug 26), app-stacking ($29 → $300+) and lock-in. Plus a zero-cost migration path to ShopVirge."
  lang="en">
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <!-- Hero -->
  <section class="hero text-white py-20 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <a href={`${base}en/comparisons/`} class="inline-flex items-center gap-1.5 text-sm font-medium text-white/80 hover:text-white mb-8">← All comparisons</a>
        <div class="flex items-center gap-3 mb-5">
          <span class="text-xs font-semibold px-3 py-1 rounded-full bg-white/15 backdrop-blur-sm border border-white/20 uppercase tracking-wide">Deep dive</span>
          <span class="text-xs font-semibold px-3 py-1 rounded-full bg-danger/30 border border-white/10">Building on rented land</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold mb-6 leading-[1.1]">Shopify vs ShopVirge</h1>
        <p class="text-xl text-white/80">
          Shopify dominates e-commerce but is under fire from its own merchants. Scripts deprecation,
          forced checkout upgrades and rising costs are pushing even Plus-level brands to explore
          alternatives. The June 30, 2026 deadline creates an urgent window.
        </p>
      </div>
    </div>
  </section>

  <!-- Overview -->
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-lg">
      <h2>The problem in one sentence</h2>
      <p>
        Shopify dominates e-commerce but is under fire from its own merchants. Scripts deprecation, forced
        checkout upgrades, rising costs and degrading support are pushing even Plus-level brands toward
        alternatives. <strong>The June 30, 2026 Scripts deadline creates an urgent window of opportunity.</strong>
      </p>
      <p>
        Below are the three pain points that surfaced most often among Shopify owners in June 2026, each
        with the evidence, and each with what ShopVirge concretely puts in its place.
      </p>
    </div>
  </section>

  <!-- Hero stat band -->
  <section class="pb-4">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-3 gap-4">
        <div class="bg-surface rounded-2xl p-6 text-center">
          <div class="text-3xl font-extrabold text-danger tabular-nums">$15K–50K</div>
          <p class="text-sm text-text-light mt-1">Scripts migration to Functions</p>
        </div>
        <div class="bg-surface rounded-2xl p-6 text-center">
          <div class="text-3xl font-extrabold text-danger tabular-nums">60%</div>
          <p class="text-sm text-text-light mt-1">functionality loss, Functions vs Scripts</p>
        </div>
        <div class="bg-surface rounded-2xl p-6 text-center">
          <div class="text-3xl font-extrabold text-danger tabular-nums">2 hours</div>
          <p class="text-sm text-text-light mt-1">global outage, $10K+ in lost sales</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Forced deadline timeline -->
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold mb-3">Two forced deadlines, one summer</h2>
      <p class="text-text-light mb-10 max-w-2xl">In under two months Shopify forces two disruptive migrations, both can silently break your store.</p>
      <div class="relative pl-6 border-l-2 border-danger/30 space-y-8">
        {deadlines.map((d) => (
          <div class="relative">
            <span class={`absolute -left-[31px] top-1 w-4 h-4 rounded-full ${d.color} ring-4 ring-white`}></span>
            <div class="bg-white rounded-2xl shadow-md p-5">
              <div class="flex items-center gap-3 mb-1">
                <span class="text-sm font-bold text-danger tabular-nums">{d.date}</span>
                <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-danger/10 text-danger">Critical</span>
              </div>
              <p class="font-bold text-text-heading">{d.label}</p>
              <p class="text-sm text-text-light">{d.sub}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pain points -->
  <section class="pb-4">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold mb-10 text-center">The three pain points dissected</h2>
      <div class="space-y-8">
        {painPoints.map((p) => (
          <div class="bg-white rounded-2xl shadow-md overflow-hidden">
            <div class="p-6 sm:p-8">
              <div class="flex items-center gap-3 mb-4">
                <span class="w-9 h-9 rounded-full bg-brand text-white flex items-center justify-center font-bold shrink-0">{p.n}</span>
                <h3 class="text-xl font-bold text-text-heading flex-1">{p.title}</h3>
                <span class={`text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap ${p.sevClass}`}>{p.severity}</span>
              </div>
              <p class="text-text mb-5">{p.problem}</p>
              <div class="grid sm:grid-cols-2 gap-4">
                <div class="bg-surface rounded-xl p-4">
                  <p class="text-xs font-semibold uppercase tracking-wide text-text-light mb-1.5">Evidence from Reddit</p>
                  <p class="text-sm text-text">{p.evidence}</p>
                </div>
                <div class="bg-brand/5 rounded-xl p-4 border border-brand/10">
                  <p class="text-xs font-semibold uppercase tracking-wide text-brand mb-1.5">The ShopVirge answer</p>
                  <p class="text-sm text-text">{p.opp}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- App-stacking chart -->
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold mb-3">The $29 promise versus reality</h2>
      <p class="text-text-light mb-10 max-w-2xl">
        New merchants discover Shopify's real cost only after launch. The $29 plan becomes $300+/month once
        you stack the required apps for reviews, SEO, email and subscriptions, a <strong>10× higher</strong>
        bill than expected.
      </p>
      <div class="space-y-5 bg-white rounded-2xl shadow-md p-6 sm:p-8">
        {appStack.map((a) => (
          <div>
            <div class="flex justify-between items-baseline mb-1.5">
              <span class="font-semibold text-text-heading">{a.name}</span>
              <span class="text-sm font-semibold text-text-light tabular-nums">{a.label}</span>
            </div>
            <div class="h-8 w-full bg-gray-100 rounded-lg overflow-hidden">
              <div class={`h-full ${a.color} rounded-lg`} style={`width: ${Math.max((a.value / stackMax) * 100, 4)}%`}></div>
            </div>
          </div>
        ))}
      </div>
      <p class="text-sm text-text-light mt-4">Illustrative, based on the reported 10× cost increase. Drivers: reviews, SEO, email and subscription apps. With ShopVirge, multilingual, SEO and product management are in the price, no app-stacking.</p>
    </div>
  </section>

  <!-- Plus tier lock-in -->
  <section class="pb-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold mb-3">Growth gets punished</h2>
      <p class="text-text-light mb-10 max-w-2xl">
        Approach $2M/yr in revenue and Shopify forces you onto Plus: $2,300/month minimum. Many merchants
        feel the features don't justify the 3–5× price jump. ShopVirge charges flat tiers, unrelated to
        your revenue.
      </p>
      <div class="space-y-5 bg-white rounded-2xl shadow-md p-6 sm:p-8">
        {plusCmp.map((c) => (
          <div>
            <div class="flex justify-between items-baseline mb-1.5">
              <span class="font-semibold text-text-heading">{c.name}</span>
              <span class="text-sm font-semibold text-text-light tabular-nums">{c.label}</span>
            </div>
            <div class="h-8 w-full bg-gray-100 rounded-lg overflow-hidden">
              <div class={`h-full ${c.color} rounded-lg`} style={`width: ${Math.max((c.value / plusMax) * 100, 1.2)}%`}></div>
            </div>
          </div>
        ))}
      </div>
      <p class="text-sm text-text-light mt-4">Plus costs around <strong>23× more per month</strong> than ShopVirge Large, plus 0.5–2% transaction fees if you don't use Shopify Payments. An $8M/yr brand publicly explored an exit for exactly this reason.</p>
    </div>
  </section>

  <!-- Why now / migration -->
  <section class="py-16 bg-surface">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold mb-3">Why June 30, 2026 is your wake-up call</h2>
      <p class="text-text-light mb-10 max-w-2xl">If Scripts forces you to migrate anyway, migrate once, to a platform that won't pressure you again. In four steps.</p>
      <div class="grid sm:grid-cols-2 gap-5">
        <div class="bg-white rounded-2xl shadow-sm p-6">
          <div class="text-brand font-extrabold text-lg mb-1">01</div>
          <h3 class="font-bold text-text-heading mb-1.5">Catalog export</h3>
          <p class="text-sm text-text-light">We export products, variants and collections out of Shopify into validated CSV/Excel.</p>
        </div>
        <div class="bg-white rounded-2xl shadow-sm p-6">
          <div class="text-brand font-extrabold text-lg mb-1">02</div>
          <h3 class="font-bold text-text-heading mb-1.5">Move discount logic</h3>
          <p class="text-sm text-text-light">No Functions rebuild: your discount rules are native in ShopVirge and don't break on a deadline.</p>
        </div>
        <div class="bg-white rounded-2xl shadow-sm p-6">
          <div class="text-brand font-extrabold text-lg mb-1">03</div>
          <h3 class="font-bold text-text-heading mb-1.5">Checkout &amp; SEO</h3>
          <p class="text-sm text-text-light">Full checkout control plus a 1-to-1 redirect map of your old Shopify URLs.</p>
        </div>
        <div class="bg-white rounded-2xl shadow-sm p-6">
          <div class="text-brand font-extrabold text-lg mb-1">04</div>
          <h3 class="font-bold text-text-heading mb-1.5">Live &amp; self-managed</h3>
          <p class="text-sm text-text-light">Open-source backend, self-host option, MCP-ready API. No more forced upgrades.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold mb-4">Migrate once, and stop building on rented land</h2>
      <p class="text-text-light mb-6">Request a free migration scan. We'll calculate your real Shopify TCO and a migration plan without a Functions rebuild.</p>
      <a href={`${base}en/contact/?type=migration-scan`} class="btn-primary">Book a migration scan →</a>
    </div>
  </section>
</Layout>
