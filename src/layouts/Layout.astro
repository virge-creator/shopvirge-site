---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  image?: string;
}
const { title, description = lang === 'en' ? "ShopVirge: your multilingual webshop in minutes. Automatic translations, Stripe payments and mobile-first design. From €50/month." : "ShopVirge: je meertalige webshop in enkele minuten. Automatische vertalingen, Stripe betalingen en mobiel-first design. Vanaf €50/maand.", lang = "nl", image } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteUrl = 'https://shopvirge.com';
const isEn = lang === 'en';
const nlBase = `${base}nl/`;
const enBase = `${base}en/`;

// Build lang-switch URL: swap /en/↔/nl/ and translate known slugs
const currentPath = Astro.url.pathname;
const slugMap: Record<string, string> = {
  'features': 'functies',
  'functies': 'features',
  'pricing': 'prijzen',
  'prijzen': 'pricing',
  'about': 'over-ons',
  'over-ons': 'about',
  'vergelijkingen': 'comparisons',
  'comparisons': 'vergelijkingen',
  // Blog post slugs NL→EN
  'ai-gepersonaliseerde-webshop-2026': 'ai-personalized-ecommerce-2026',
  'ai-productbeschrijvingen-webshop-2026': 'ai-product-descriptions-webshop-2026',
  'ai-revolutie-ecommerce-2026': 'ai-revolution-ecommerce-2026',
  'meertalige-webshop-5-fouten': 'multilingual-webshop-5-mistakes',
  'shopify-alternatieven-europa-2026': 'shopify-alternatives-europe-2026',
  'social-commerce-revolutie-europa-2026': 'social-commerce-revolution-europe-2026',
  'tiktok-shop-nederland-2026': 'tiktok-shop-netherlands-2026',
  // Blog post slugs EN→NL
  'ai-personalized-ecommerce-2026': 'ai-gepersonaliseerde-webshop-2026',
  'ai-product-descriptions-webshop-2026': 'ai-productbeschrijvingen-webshop-2026',
  'ai-revolution-ecommerce-2026': 'ai-revolutie-ecommerce-2026',
  'multilingual-webshop-5-mistakes': 'meertalige-webshop-5-fouten',
  'shopify-alternatives-europe-2026': 'shopify-alternatieven-europa-2026',
  'social-commerce-revolution-europe-2026': 'social-commerce-revolutie-europa-2026',
  'tiktok-shop-netherlands-2026': 'tiktok-shop-nederland-2026',
};
function switchLangUrl(path: string, toLang: 'nl' | 'en'): string {
  // Replace /en/ with /nl/ or vice versa
  let switched = toLang === 'nl'
    ? path.replace(/^\/en\//, '/nl/')
    : path.replace(/^\/nl\//, '/en/');
  // Extract all path segments and translate known slugs
  const parts = switched.split('/');
  for (let i = 0; i < parts.length; i++) {
    if (slugMap[parts[i]]) {
      parts[i] = slugMap[parts[i]];
    }
  }
  return parts.join('/');
}
const nlUrl = switchLangUrl(currentPath, 'nl');
const enUrl = switchLangUrl(currentPath, 'en');
const canonicalUrl = `${siteUrl}${currentPath}`;
const fullNlUrl = `${siteUrl}${nlUrl}`;
const fullEnUrl = `${siteUrl}${enUrl}`;
const ogImage = image || `${siteUrl}${base}images/logo.png`;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | ShopVirge</title>
  <link rel="icon" type="image/png" href={`${base}images/logo.png`} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="nl" href={fullNlUrl} />
  <link rel="alternate" hreflang="en" href={fullEnUrl} />
  <link rel="alternate" hreflang="x-default" href={fullNlUrl} />
  <!-- Open Graph -->
  <meta property="og:title" content={`${title} | ShopVirge`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'nl_NL'} />
  <meta property="og:site_name" content="ShopVirge" />
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | ShopVirge`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <!-- Organization structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "ShopVirge",
    "url": siteUrl,
    "logo": `${siteUrl}${base}images/logo.png`,
    "description": "Open-source multilingual webshop platform with automatic translations, Stripe payments and MCP-ready API.",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Julianastraat 63",
      "addressLocality": "Stramproy",
      "postalCode": "6039 AH",
      "addressCountry": "NL"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+31-495-794-123",
      "email": "support@shopvirge.com",
      "contactType": "customer service"
    }
  })} />
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-28TWH2DFQF"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-28TWH2DFQF');
  </script>
  <!-- lemlist visitor tracking -->
  <script is:inline type="text/javascript" src="https://app.lemlist.com/api/visitors/tracking?k=vRslB%2Bd5PWgp5ciD6glfqRX3KoULBl4ObXVF92gzdkA%3D&t=tea_Xd7WQ6rX5hYMWPur9"></script>
</head>
<body class="min-h-screen flex flex-col">
  <!-- Header -->
  <header class="fixed top-0 w-full bg-white/95 backdrop-blur-sm shadow-sm z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href={isEn ? enBase : nlBase} class="flex items-center gap-2">
          <img src={`${base}images/logo.png`} alt="ShopVirge logo (meertalig webshop platform)" class="h-9" />
        </a>
        
        <nav class="hidden md:flex items-center gap-8">
          <a href={isEn ? `${enBase}features/` : `${nlBase}functies/`} class="text-sm font-medium text-gray-700 hover:text-brand transition-colors">
            {isEn ? 'Features' : 'Functies'}
          </a>
          <a href={isEn ? `${enBase}pricing/` : `${nlBase}prijzen/`} class="text-sm font-medium text-gray-700 hover:text-brand transition-colors">
            {isEn ? 'Pricing' : 'Prijzen'}
          </a>
          <a href={isEn ? `${enBase}blog/` : `${nlBase}blog/`} class="text-sm font-medium text-gray-700 hover:text-brand transition-colors">
            Blog
          </a>
          <a href={isEn ? `${enBase}contact/` : `${nlBase}contact/`} class="text-sm font-medium text-gray-700 hover:text-brand transition-colors">
            Contact
          </a>

          <!-- Language switcher dropdown -->
          <div class="relative" id="lang-switcher">
            <button id="lang-btn" class="flex items-center gap-1.5 text-sm font-medium text-gray-700 hover:text-brand transition-colors px-3 py-1.5 rounded-lg border border-gray-200 hover:border-brand/30 bg-white">
              <span class="text-base">{isEn ? '🇬🇧' : '🇳🇱'}</span>
              <span>{isEn ? 'EN' : 'NL'}</span>
              <svg class="w-3.5 h-3.5 text-gray-400 transition-transform" id="lang-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div id="lang-dropdown" class="absolute right-0 mt-2 w-40 bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden opacity-0 invisible transition-all duration-200 origin-top-right scale-95">
              <a href={nlUrl} class={`flex items-center gap-3 px-4 py-3 text-sm hover:bg-brand/5 transition-colors ${!isEn ? 'bg-brand/5 text-brand font-semibold' : 'text-gray-700'}`}>
                <span class="text-lg">🇳🇱</span>
                <span>Nederlands</span>
                {!isEn && <svg class="w-4 h-4 ml-auto text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>}
              </a>
              <a href={enUrl} class={`flex items-center gap-3 px-4 py-3 text-sm hover:bg-brand/5 transition-colors ${isEn ? 'bg-brand/5 text-brand font-semibold' : 'text-gray-700'}`}>
                <span class="text-lg">🇬🇧</span>
                <span>English</span>
                {isEn && <svg class="w-4 h-4 ml-auto text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>}
              </a>
            </div>
          </div>

          <a href={isEn ? `${enBase}contact/?type=demo` : `${nlBase}contact/?type=demo`} data-open-demo class="btn-primary text-sm !px-5 !py-2">
            {isEn ? 'Get a demo' : 'Demo aanvragen'}
          </a>
        </nav>

        <!-- Mobile right side: demo CTA + menu -->
        <div class="md:hidden flex items-center gap-2">
          <a href={isEn ? `${enBase}contact/?type=demo` : `${nlBase}contact/?type=demo`} data-open-demo class="btn-primary text-sm !px-4 !py-2">
            {isEn ? 'Get a demo' : 'Demo'}
          </a>
          <button id="mobile-menu-btn" class="p-2 text-gray-700" aria-label="Menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
    
    <!-- Mobile menu -->
    <div id="mobile-menu" class="md:hidden" style="display:none;">
      <div class="px-4 py-4 space-y-3 bg-white border-t">
        <a href={isEn ? `${enBase}features/` : `${nlBase}functies/`} class="block text-sm font-medium text-gray-700">{isEn ? 'Features' : 'Functies'}</a>
        <a href={isEn ? `${enBase}pricing/` : `${nlBase}prijzen/`} class="block text-sm font-medium text-gray-700">{isEn ? 'Pricing' : 'Prijzen'}</a>
        <a href={isEn ? `${enBase}blog/` : `${nlBase}blog/`} class="block text-sm font-medium text-gray-700">Blog</a>
        <a href={isEn ? `${enBase}contact/` : `${nlBase}contact/`} class="block text-sm font-medium text-gray-700">Contact</a>
        <div class="border-t border-gray-100 pt-3">
          <p class="text-xs text-gray-400 uppercase tracking-wider mb-2">{isEn ? 'Language' : 'Taal'}</p>
          <div class="flex gap-2">
            <a href={nlUrl} class={`flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium transition-colors ${!isEn ? 'bg-brand/10 text-brand' : 'text-gray-600 hover:bg-gray-50'}`}>
              🇳🇱 NL
            </a>
            <a href={enUrl} class={`flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium transition-colors ${isEn ? 'bg-brand/10 text-brand' : 'text-gray-600 hover:bg-gray-50'}`}>
              🇬🇧 EN
            </a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="flex-1 pt-16">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-surface-dark text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-4 gap-8">
        <div>
          <img src={`${base}images/logo.png`} alt="ShopVirge logo" class="h-8 mb-4 brightness-200" />
          <p class="text-gray-400 text-sm">
            {isEn
              ? 'Launch your multilingual online shop or product-portfolio in minutes.'
              : 'Lanceer je meertalige webshop of product-portfolio in enkele minuten.'}
          </p>
        </div>
        <div>
          <h4 class="font-semibold mb-3">{isEn ? 'Quick Links' : 'Snelle Links'}</h4>
          <ul class="space-y-2 text-sm text-gray-400">
            <li><a href={isEn ? `${enBase}features/` : `${nlBase}functies/`} class="hover:text-white transition-colors">{isEn ? 'Features' : 'Functies'}</a></li>
            <li><a href={isEn ? `${enBase}pricing/` : `${nlBase}prijzen/`} class="hover:text-white transition-colors">{isEn ? 'Pricing' : 'Prijzen'}</a></li>
            <li><a href={isEn ? `${enBase}comparisons/` : `${nlBase}vergelijkingen/`} class="hover:text-white transition-colors">{isEn ? 'Comparisons' : 'Vergelijkingen'}</a></li>
            <li><a href={isEn ? `${enBase}webinars/` : `${nlBase}webinars/`} class="hover:text-white transition-colors">Webinars</a></li>
            <li><a href={isEn ? `${enBase}blog/` : `${nlBase}blog/`} class="hover:text-white transition-colors">Blog</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-semibold mb-3">Info</h4>
          <ul class="space-y-2 text-sm text-gray-400">
            <li><a href={isEn ? `${enBase}about/` : `${nlBase}over-ons/`} class="hover:text-white transition-colors">{isEn ? 'About us' : 'Over ons'}</a></li>
            <li><a href={isEn ? `${enBase}contact/` : `${nlBase}contact/`} class="hover:text-white transition-colors">Contact</a></li>
            <li><a href={isEn ? `${enBase}privacy/` : `${nlBase}privacy/`} class="hover:text-white transition-colors">Privacy</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-semibold mb-3">{isEn ? 'Visit us' : 'Bezoek ons'}</h4>
          <address class="text-sm text-gray-400 not-italic">
            Julianastraat 63<br />
            6039 AH Stramproy<br />
            {isEn ? 'The Netherlands' : 'Nederland'}
          </address>
        </div>
      </div>
      <div class="border-t border-gray-700 mt-8 pt-8 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-sm text-gray-500">
        <span>&copy; {new Date().getFullYear()} ShopVirge. {isEn ? 'All rights reserved.' : 'Alle rechten voorbehouden.'}</span>
        <span class="hidden sm:inline text-gray-700">·</span>
        <a href="https://virge.io" target="_blank" rel="noopener" class="hover:text-white transition-colors">
          {isEn ? 'Powered by ' : 'Mogelijk gemaakt door '}<span class="font-semibold text-gray-300">Virge</span>
        </a>
      </div>
    </div>
  </footer>

  <!-- Demo request modal -->
  <dialog id="demo-modal" class="demo-modal">
    <div class="demo-modal-inner">
      <button id="demo-close" type="button" class="demo-close" aria-label={isEn ? 'Close' : 'Sluiten'}>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

      <div class="mb-6">
        <h2 class="text-2xl md:text-3xl font-extrabold text-text-heading mb-2 tracking-tight">
          {isEn ? 'Request a demo' : 'Demo aanvragen'}
        </h2>
        <p class="text-text-light">
          {isEn
            ? 'A 30-minute video call. We show you the platform and answer your questions.'
            : 'Een videocall van 30 minuten. We laten je het platform zien en beantwoorden je vragen.'}
        </p>
      </div>

      <form id="demo-form" action="https://formspree.io/f/mkokrkdl" method="POST" class="space-y-4">
        <input type="hidden" name="_subject" value={isEn ? 'Demo request - ShopVirge' : 'Demo aanvraag - ShopVirge'} />
        <input type="hidden" name="type" value="demo" />
        <input type="hidden" name="source" value="header-modal" />

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">{isEn ? 'Name' : 'Naam'} *</label>
            <input type="text" name="name" required class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">{isEn ? 'Company' : 'Bedrijfsnaam'}</label>
            <input type="text" name="company" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none" />
          </div>
        </div>

        <div class="bg-brand/5 border border-brand/15 rounded-lg px-3.5 py-2.5 text-sm text-text-light">
          {isEn
            ? 'Provide an email or phone number so we can reach you.'
            : 'Geef een e-mailadres of telefoonnummer zodat we contact kunnen opnemen.'}
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">{isEn ? 'Email' : 'E-mail'}</label>
          <input type="email" name="email" data-contact-field class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none" />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">{isEn ? 'Phone' : 'Telefoon'}</label>
          <input type="tel" name="phone" data-contact-field class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none" />
        </div>

        <p id="demo-contact-error" class="hidden text-sm text-danger">
          {isEn ? 'Please enter your email or phone number.' : 'Vul je e-mailadres of telefoonnummer in.'}
        </p>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">{isEn ? 'What would you like to see?' : 'Wat wil je graag zien?'}</label>
          <textarea name="message" rows="3" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none resize-none"></textarea>
        </div>

        <button type="submit" class="btn-primary w-full">
          {isEn ? 'Request demo →' : 'Demo aanvragen →'}
        </button>
      </form>
    </div>
  </dialog>

  <script>
    // Mobile menu
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => {
      menu!.style.display = menu!.style.display === 'none' ? 'block' : 'none';
    });

    // Language dropdown
    const langBtn = document.getElementById('lang-btn');
    const langDropdown = document.getElementById('lang-dropdown');
    const langChevron = document.getElementById('lang-chevron');
    let langOpen = false;

    langBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      langOpen = !langOpen;
      if (langOpen) {
        langDropdown!.classList.remove('opacity-0', 'invisible', 'scale-95');
        langDropdown!.classList.add('opacity-100', 'visible', 'scale-100');
        langChevron!.style.transform = 'rotate(180deg)';
      } else {
        langDropdown!.classList.add('opacity-0', 'invisible', 'scale-95');
        langDropdown!.classList.remove('opacity-100', 'visible', 'scale-100');
        langChevron!.style.transform = '';
      }
    });

    document.addEventListener('click', () => {
      if (langOpen) {
        langOpen = false;
        langDropdown?.classList.add('opacity-0', 'invisible', 'scale-95');
        langDropdown?.classList.remove('opacity-100', 'visible', 'scale-100');
        if (langChevron) langChevron.style.transform = '';
      }
    });

    // Demo modal
    const demoModal = document.getElementById('demo-modal') as HTMLDialogElement | null;
    const demoClose = document.getElementById('demo-close');
    const demoForm = document.getElementById('demo-form') as HTMLFormElement | null;
    const demoError = document.getElementById('demo-contact-error');
    document.querySelectorAll('[data-open-demo]').forEach((el) => {
      el.addEventListener('click', (e) => {
        if (!demoModal) return;
        e.preventDefault();
        demoModal.showModal();
        (demoModal.querySelector('input[name="name"]') as HTMLInputElement | null)?.focus();
      });
    });
    demoClose?.addEventListener('click', () => demoModal?.close());
    demoModal?.addEventListener('click', (e) => {
      if (e.target === demoModal) demoModal.close();
    });
    demoForm?.addEventListener('submit', (e) => {
      const email = (demoForm.querySelector('input[name="email"]') as HTMLInputElement | null)?.value.trim() || '';
      const phone = (demoForm.querySelector('input[name="phone"]') as HTMLInputElement | null)?.value.trim() || '';
      if (!email && !phone) {
        e.preventDefault();
        demoError?.classList.remove('hidden');
        (demoForm.querySelector('input[name="email"]') as HTMLInputElement | null)?.focus();
      } else {
        demoError?.classList.add('hidden');
      }
    });
  </script>
</body>
</html>
