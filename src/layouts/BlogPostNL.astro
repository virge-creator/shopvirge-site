---
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<Layout title={frontmatter.title} description={frontmatter.description} lang="nl">
  <article>
    <header class="bg-surface border-b border-gray-100">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-10 pb-14 md:pt-14 md:pb-20">
        <a href={`${base}nl/blog/`} class="inline-flex items-center gap-1.5 text-sm font-medium text-brand hover:underline mb-10">
          ← Terug naar blog
        </a>

        {frontmatter.tags && (
          <div class="flex flex-wrap gap-2 mb-5">
            {frontmatter.tags.map((tag: string) => (
              <span class="inline-block px-2.5 py-1 bg-brand/10 text-brand text-xs font-semibold rounded-full uppercase tracking-wide">{tag}</span>
            ))}
          </div>
        )}

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-text-heading leading-[1.1] tracking-tight mb-6" style="text-wrap: balance;">
          {frontmatter.title}
        </h1>

        {frontmatter.description && (
          <p class="text-xl text-text-light leading-relaxed max-w-2xl mb-8" style="text-wrap: pretty;">
            {frontmatter.description}
          </p>
        )}

        <div class="flex flex-wrap items-center gap-3 text-sm text-text-light">
          {frontmatter.author && (
            <span class="flex items-center gap-2 font-medium text-text">
              <span class="w-7 h-7 bg-brand text-white rounded-full flex items-center justify-center text-xs font-bold">
                {frontmatter.author.charAt(0)}
              </span>
              {frontmatter.author}
            </span>
          )}
          {frontmatter.author && <span class="text-gray-300">·</span>}
          <time datetime={frontmatter.date}>
            {new Date(frontmatter.date).toLocaleDateString('nl-NL', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
      </div>
    </header>

    {frontmatter.image && (
      <div class="max-w-4xl mx-auto px-4 sm:px-6 -mt-8 md:-mt-12 mb-12 md:mb-16">
        <div class="rounded-2xl overflow-hidden aspect-video shadow-xl">
          <img src={frontmatter.image.startsWith('http') ? frontmatter.image : `${base}${frontmatter.image}`}
               alt={frontmatter.title}
               class="w-full h-full object-cover" />
        </div>
      </div>
    )}

    <div class="max-w-4xl mx-auto px-4 sm:px-6 pb-20">
      <div class="prose prose-lg">
        <slot />
      </div>

      {frontmatter.author && (
        <div class="mt-16 p-6 bg-surface rounded-2xl flex items-center gap-4">
          <div class="w-12 h-12 bg-brand text-white rounded-full flex items-center justify-center text-lg font-bold shrink-0">
            {frontmatter.author.charAt(0)}
          </div>
          <div>
            <p class="font-semibold text-text-heading">{frontmatter.author}</p>
            <p class="text-sm text-text-light">ShopVirge Blog</p>
          </div>
        </div>
      )}

      <div class="mt-12 p-8 bg-brand/5 rounded-2xl text-center">
        <h3 class="text-xl font-bold text-text-heading mb-2">Klaar om te starten?</h3>
        <p class="text-text-light mb-4">Lanceer je eigen meertalige webshop met ShopVirge.</p>
        <a href={`${base}nl/contact/`} class="btn-primary">Neem contact op →</a>
      </div>
    </div>
  </article>
</Layout>
