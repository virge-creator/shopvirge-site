---
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteUrl = 'https://shopvirge.com';
const imgSrc = frontmatter.image
  ? (frontmatter.image.startsWith('http') ? frontmatter.image : `${base}${frontmatter.image}`)
  : null;
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": frontmatter.title,
  "description": frontmatter.description,
  "datePublished": frontmatter.date,
  "author": { "@type": "Person", "name": frontmatter.author || "ShopVirge Editorial" },
  "publisher": { "@type": "Organization", "name": "ShopVirge", "logo": { "@type": "ImageObject", "url": `${siteUrl}${base}images/logo.png` } },
  "image": frontmatter.image || `${siteUrl}${base}images/logo.png`,
  "url": `${siteUrl}${Astro.url.pathname}`,
  "inLanguage": "en",
};
---
<Layout title={frontmatter.title} description={frontmatter.description} image={frontmatter.image} lang="en">
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  <article>
    <header class={`relative isolate overflow-hidden ${imgSrc ? 'text-white' : 'bg-surface border-b border-gray-100'}`}>
      {imgSrc && (
        <>
          <img src={imgSrc} alt="" aria-hidden="true" class="absolute inset-0 -z-20 w-full h-full object-cover" />
          <div class="absolute inset-0 -z-10 hero-blur-overlay"></div>
          <div class="absolute inset-x-0 bottom-0 -z-10 h-24 bg-gradient-to-b from-transparent to-white"></div>
        </>
      )}

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-72 md:pt-14 md:pb-96">
        <div class="max-w-5xl">
          <a href={`${base}en/blog/`} class={`inline-flex items-center gap-1.5 text-sm font-medium mb-10 ${imgSrc ? 'text-white/90 hover:text-white' : 'text-brand hover:underline'}`}>
            ← Back to blog
          </a>

          {frontmatter.tags && (
            <div class="flex flex-wrap gap-2 mb-5">
              {frontmatter.tags.map((tag: string) => (
                <span class={`inline-block px-2.5 py-1 text-xs font-semibold rounded-full uppercase tracking-wide ${imgSrc ? 'bg-white/15 text-white backdrop-blur-sm border border-white/20' : 'bg-brand/10 text-brand'}`}>{tag}</span>
              ))}
            </div>
          )}

          <h1 class={`text-4xl md:text-5xl lg:text-6xl font-extrabold leading-[1.1] tracking-tight mb-6 ${imgSrc ? 'text-white drop-shadow-md' : 'text-text-heading'}`} style="text-wrap: balance;">
            {frontmatter.title}
          </h1>

          {frontmatter.description && (
            <p class={`text-xl leading-relaxed max-w-2xl mb-8 ${imgSrc ? 'text-white/90' : 'text-text-light'}`} style="text-wrap: pretty;">
              {frontmatter.description}
            </p>
          )}

          <div class={`flex flex-wrap items-center gap-3 text-sm ${imgSrc ? 'text-white/85' : 'text-text-light'}`}>
            {frontmatter.author && (
              <span class={`flex items-center gap-2 font-medium ${imgSrc ? 'text-white' : 'text-text'}`}>
                <span class="w-7 h-7 bg-brand text-white rounded-full flex items-center justify-center text-xs font-bold ring-2 ring-white/40">
                  {frontmatter.author.charAt(0)}
                </span>
                {frontmatter.author}
              </span>
            )}
            {frontmatter.author && <span class={imgSrc ? 'text-white/40' : 'text-gray-300'}>·</span>}
            <time datetime={frontmatter.date}>
              {new Date(frontmatter.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </div>
        </div>
      </div>
    </header>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 md:pt-16 pb-20">
      <div class="max-w-5xl prose prose-lg">
        <slot />
      </div>

      {frontmatter.author && (
        <div class="max-w-5xl mt-16 p-6 bg-surface rounded-2xl flex items-center gap-4">
          <div class="w-12 h-12 bg-brand text-white rounded-full flex items-center justify-center text-lg font-bold shrink-0">
            {frontmatter.author.charAt(0)}
          </div>
          <div>
            <p class="font-semibold text-text-heading">{frontmatter.author}</p>
            <p class="text-sm text-text-light">ShopVirge Blog</p>
          </div>
        </div>
      )}

      <div class="max-w-5xl mt-12 p-8 bg-brand/5 rounded-2xl text-center">
        <h3 class="text-xl font-bold text-text-heading mb-2">Ready to get started?</h3>
        <p class="text-text-light mb-4">Launch your own multilingual webshop with ShopVirge.</p>
        <a href={`${base}en/contact/`} class="btn-primary">Get in touch →</a>
      </div>
    </div>
  </article>
</Layout>
